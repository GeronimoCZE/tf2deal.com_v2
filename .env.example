# Copy this file to src/config/.env and fill in your values. Never upload the real .env anywhere.

# --- Required ---
DB_CONNECTION=            # MongoDB connection string, e.g. mongodb+srv://user:pass@cluster/tf2deal
SITE_URL=https://tf2deal.com   # the address of the site (used for Steam sign-in and secure cookies)
TRUST_PROXY=                    # 1 when Nginx is in front of the site, 2 for Cloudflare + Nginx, empty when visitors reach Node directly
SESSION_SECRET=           # long random text, at least 32 characters (keeps people signed in safely)
API_KEY_STEAM=            # Steam Web API key: https://steamcommunity.com/dev/apikey
ADMIN_STEAMID=            # the Steam ID (7656...) of the admin account
ADMIN_PASSWORD=           # password asked on /login before the admin panel opens

# --- Bot server and item server ---
BOTS_ENDPOINT=            # address of the bot server
ITEMS_ENDPOINT=           # address of the item server
SERVER_TOKEN=             # shared with the bot/item server and with apps that change settings live
SERVER_SECRET=
CLIENT_TOKEN=             # used by the item server when it calls /api/items
CLIENT_SECRET=
PASSWORD=                 # password the bot server expects from the site

# --- Other services ---
CORS_SERVER_URL=
BPAPI_ENDPOINT=
API_KEY_STEAM_APIS=
API_KEY_BPTF=
API_KEY_TF2DEAL=
STEAM_GROUP_ID=           # your Steam group's id number, for the giveaway requirement and announcements

# --- Optional ---
SETTINGS_READ_TOKEN=      # read-only access to live settings for other apps
CLOUDFLARE_ACCOUNT_ID=    # free AI translation of blog posts and giveaways (Cloudflare Workers AI)
CLOUDFLARE_AI_TOKEN=
ANTHROPIC_API_KEY=        # paid AI translation with Claude instead
TRANSLATE_PROVIDER=       # cloudflare or claude, when both are set
TRANSLATE_MODEL=
PORT=8080

# --- Giveaway announcements (optional, see docs/SETUP.md) ---
# A new giveaway is posted on your Steam group and Facebook Page, and removed again when it ends or is cancelled.
STEAM_GROUP_ACCOUNT=      # sign-in name of a Steam account that is an officer of the group (not a trading bot)
STEAM_GROUP_PASSWORD=
STEAM_GROUP_SHARED_SECRET= # shared_secret of that account's Steam Guard mobile authenticator
FACEBOOK_PAGE_ID=         # your Facebook Page's id
FACEBOOK_PAGE_TOKEN=      # a Page access token that can post on the Page
