<!DOCTYPE html>
<html lang="en">
    <%- include('./partials/head.ejs') %>
    <body>
        <%- include('./partials/nav.ejs') %>
        
        <main>
            <div class="scroll-up-btn">
                <div class="icon icon-arrow_down"></div>
            </div>
            <div class="page-section home-ps-1">
                <div class="bg-block">
                    <div class="color-image"></div>
                    <img class="home-background1" src="/img/cabin-bw.webp" alt="">
                </div>
                <div class="home-text">
                    <div class="main-text">
                        <h1 class="lang lang-en">Trade, buy or sell<br> your TF2 items!</h1>
                        <h1 class="lang lang-zh">交易、购买或出售您的<br> TF2 物品</h1>
                        <h1 class="lang lang-es">¡Comercia, compra o vende tus <br>artículos de TF2!</h1>
                        <h1 class="lang lang-fr">Echangez, achetez ou vendez <br> vos objets TF2 !</h1>
                        <h1 class="lang lang-ru">Торгуйте, покупайте или продавайте <br> свои предметы TF2!</h1>
                        <h1 class="lang lang-pt">Troque, compre ou venda <br> seus itens do TF2!</h1>
                        <h1 class="lang lang-de">Handeln, kaufen oder verkaufen <br> Sie Ihre TF2-Artikel!</h1>
                    </div>
                    <div class="trade-status up"><span class="icon icon-signal"></span> 
                      <span>Trading is up</span>
                    </div>
                    <% if (user) { %>
                        <a href="/trade" class="start_trading-btn">
                            Start Trading
                        </a>
                    <% } else { %>
                      <a href="/auth/steam" class="start_trading-btn">
                        Start Trading
                      </a>
                    <% } %>
                </div>
                <div class="site-stats">
                    <div class="stat-block">
                        <!-- users online -->
                        <span class="icon-group stat-icon"></span>
                        <div class="stat-text">
                            <div class="stat-name">
                                <span>Users Online</span>
                            </div>
                            <div class="stat-data" id="stat-onlineUsers"></div>
                        </div>
                    </div>
                    <div class="stat-block">
                        <!-- trades today -->
                        <span class="icon-trade2 stat-icon"></span>
                        <div class="stat-text">
                            <div class="stat-name">
                                <span>Trades Today</span>
                            </div>
                            <div class="stat-data" id="stat-tradesToday"></div>
                        </div>
                    </div>
                    <div class="stat-block">
                        <!-- items available -->
                        <span class="icon-hat2 stat-icon"></span>
                        <div class="stat-text">
                            <div class="stat-name">
                                <span>Items Available</span>
                            </div>
                            <div class="stat-data" id="stat-itemsAvailable"></div>
                        </div>
                    </div>
                    <div class="stat-block">
                        <!-- active trade bots -->
                        <span class="icon-verified stat-icon"></span>
                        <div class="stat-text">
                            <div class="stat-name">
                                <span>Steam Bots</span>
                            </div>
                            <div class="stat-data" id="stat-botsRunning"></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="page-section home-ps-2">
                <div class="site-trades">
                    <div class="header"></div>
                    <div class="content">
                        
                    </div>
                </div>
                <div class="trustpilot-widget" data-locale="en-US" data-template-id="5419b6a8b0d04a076446a9ad" data-businessunit-id="61e1d4edb101cd65eeb4297e" data-style-height="24px" data-style-width="100%" data-theme="dark" data-min-review-count="10" data-without-reviews-preferred-string-id="1" data-style-alignment="center">
                  <a href="https://www.trustpilot.com/review/tf2deal.com" target="_blank" rel="noopener">Trustpilot</a>
                </div>
                <!-- heading -->
                <!-- text -->
                <!-- X-AXIS SLIDER FOR POPULAR / STOCKED ITEMS -->
                <div class="meet-the-tf2deal">
                  <section>
                    <img class="sec-img-1" src="https://community.cloudflare.steamstatic.com/economy/image/fWFc82js0fmoRAP-qOIPu5THSWqfSmTELLqcUywGkijVjZULUrsm1j-9xgEMaQkUTxr2vTx8mMnvA-aHAfQ_ktk664MayTdinxVwPffiZghuZgHPUPUPD6cF4w3tG3Z8v5QzV4XuobgDfF3q5oPBMuF9Y4xFSZTYCfWFZ1__7xk81qVbLpPapzSvg3pBAL-zcw/360fx360f" alt="">
                    <div class="text">
                      <h3 style="color: #fe8235;">Tired of unaccurate skin prices?</h3>
                      <p>Say no more! I know how unfair can pricing for <span class="important">Decorated items</span> be. Therefore I'm trying to provide the most accurate skin / warpaint prices.</p>
                    </div>
                  </section>
                  <section>
                    <img class="sec-img-2" style="background-image: url('https://backpack.tf/images/440/particles/13_380x380.png'); background-repeat: no-repeat; background-size: cover;" src="https://community.akamai.steamstatic.com/economy/image/fWFc82js0fmoRAP-qOIPu5THSWqfSmTELLqcUywGkijVjZULUrsm1j-9xgEPaQRACCTyuSxRgcfyMuKJCes_l9sn4pUbjjc5wFF6bbLlZGdlIgCUBaUOD6Ri8A3pUSIzuJM7VdHgrr4FKgvr55yGbee5wgK2nw/360fx360f" alt="">
                    <div class="text">
                      <h3 style="color: #8055f6;">Fan of Unusuals?</h3>
                      <p>You are in the right place! I'm personally a big fan of shinny effects. Doesn't matter if they are on a Cosmetic, Weapon or Taunt. Am I right?</p>
                    </div>
                  </section>
                  <section>
                    <img class="sec-img-3" src="https://community.cloudflare.steamstatic.com/economy/image/fWFc82js0fmoRAP-qOIPu5THSWqfSmTELLqcUywGkijVjZULUrsm1j-9xgEYYwsVVB7whzBMhMHiDOuzCe4Ul98n9q9Z2CRslE9-YOHsYWQ3d1CbUfBdWaE7o1q-WyE06Z8zBo7u8rpTLQq9sdHDNLQrLpgSSIcHt1sP/360fx360f" alt="">
                    <div class="text">
                      <h3 style="color: #7fdf4c;">Just a cheap Misc for your set?</h3>
                      <p>We've got a plenty of cheap Cosmetics in different qualities. Just grab one!</p>
                    </div>
                  </section>
                  <section>
                    <img class="sec-img-4" src="https://community.cloudflare.steamstatic.com/economy/image/fWFc82js0fmoRAP-qOIPu5THSWqfSmTELLqcUywGkijVjZULUrsm1j-9xgEJbQQaTRrhswdGkNjnA_aJGt8Mmsgy4N5UjW5uwAd4ZrDlMmI1J1zGWPYNCqY7ol-_XiRmv587VdHvrr0CL13uqsKYZJhWvX8I/360fx360f" alt="">
                    <div class="text">
                      <h3>Tools</h3>
                      <p>Looking to expand your inventory? Give your gun a killstreaker? We've got your back!</p>
                    </div>
                  </section>
                </div>
            </div>
            <div class="page-section home-ps-3" id="faq">
                <!-- img on left, text on right => IS A FINAL SECTION! -->
                <div class="images">
                  <img src="/img/sfm_tree.png" alt="">
                  <div class="snow-bottom">
                    <!-- absolute; full width -->
                  </div>
                </div>
                <div class="text-area">
                  <div class="faq">
                    <div class="faq-header">Frequently Asked Questions</div>
                    <div class="faq-body">
                        <section>
                            <div class="header">How does this work?</div>
                            <div class="body">tf2deal.com is a trading site. This means you trade your items for our items.</div>
                        </section>
                        <section>
                            <div class="header">Can I sell (buy) for pure?</div>
                            <div class="body"><span>Yes</span>, if there is enough pure on the paying side. Otherwise you can get mixed (pure & items).</div>
                        </section>
                        <section>
                            <div class="header">Microtransactions?</div>
                            <div class="body"><span>No</span>, we don't support real world money transactions. There is no balance either!</div>
                        </section>
                        <section>
                            <div class="header">Deposits?</div>
                            <div class="body"><span>No</span>, we would never ask you to deposit your items.</div>
                        </section>
                    </div>
                  </div>
                </div>
            </div>
        </main>
        
        <%- include('./partials/footer.ejs') %>

        <script src="/socket.io/socket.io.js"></script>
        <script type="application/javascript">
            const statUsers = document.getElementById('stat-onlineUsers');
            const statTrades = document.getElementById('stat-tradesToday');
            const statItems = document.getElementById('stat-itemsAvailable');
            const statBots = document.getElementById('stat-botsRunning');

            socket.emit('getSiteData', () => {
            });
            socket.on('siteData', function(res) {
                statUsers.style = `--from: 0; --to: ${res.onlineUsers}; --duration: 3s; --timing: ease`;
                statTrades.style = `--from: 0; --to: ${res.tradesToday}; --duration: 3; --timing: ease`;
                statItems.style = `--from: 0; --to: ${res.itemsAvailable}; --duration: 5s; --timing: ease`;
                statBots.style = `--from: 0; --to: ${res.botsRunning}; --duration: 2s; --timing: ease`;

                if(navigator.userAgent.toLowerCase().indexOf('firefox') > -1){
                    statUsers.setAttribute('data-num', res.onlineUsers);
                    statTrades.setAttribute('data-num', res.tradesToday);
                    statItems.setAttribute('data-num', res.itemsAvailable);
                    statBots.setAttribute('data-num', res.botsRunning);
                }
            });

            document.querySelector('.home-ps-1').classList.add('animate')
            if(sessionStorage.getItem('tf2deal-home-animation') == null){
                setTimeout(()=> {
                    sessionStorage.setItem('tf2deal-home-animation', '1')
                }, 3300)
            }

            // scroll listener for animations
            // once per session!
            const pageSections = document.querySelectorAll('.page-section')

            const alreadyAnimated = () => {
                let animated = sessionStorage.getItem('tf2deal-home-animation')
                if(animated != null){
                    for (let i = 0; i < animated; i++) {
                        pageSections[i].classList.add('animated')
                    }
                }
            }

            alreadyAnimated();

            let didScroll = false;

            if(pageSections[pageSections.length - 1].classList[1].slice(-1) != sessionStorage.getItem('tf2deal-home-animation')){
                $(window).scroll(function() {
                    didScroll = true;
                });
            }

            setInterval(function() {
                if ( didScroll ) {
                    didScroll = false;
                    // Check your page position and then
                    // Load in more results
                    psDetection(pageSections)
                }
            }, 500);

            const psDetection = (els) => {
                els.forEach(el => {
                    var bounding = el.getBoundingClientRect();
                    var elHeight = el.offsetHeight;
                    var elWidth = el.offsetWidth;

                    elementInViewport()

                    function elementInViewport() {

                        var bounding = el.getBoundingClientRect();

                        if (bounding.top >= -elHeight 
                            && bounding.left >= -elWidth
                            && bounding.right <= (window.innerWidth || document.documentElement.clientWidth) + elWidth
                            && bounding.bottom <= (window.innerHeight || document.documentElement.clientHeight) + elHeight) {

                            // work with ps
                            if(!el.classList.contains('animate') || !el.classList.contains('animated')){
                                el.classList.add('animate')
                                if(sessionStorage.getItem('tf2deal-home-animation') == null || sessionStorage.getItem('tf2deal-home-animation') < el.classList[1].slice(-1)){
                                    sessionStorage.setItem('tf2deal-home-animation', el.classList[1].slice(-1))
                                }
                            }
                        }
                    }
                });
            }
        </script>
        <script type="module" defer>
            if(window.location.search.includes('login_error=true')){
                iziToast.error({
                    title: 'Error with login!',
                    message: 'Try again later',
                    timeout: 10000
                })
            }
        </script>
    </body>
</html>
