<!DOCTYPE html>
<html lang="en">
    <%- include('./partials/head.ejs') %>
    <body>
        <%- include('./partials/nav.ejs') %>
        
        <main>
            <div class="page-section items-ps">
                <h2 style="font-weight: bold;">Item Database</h2>
                <div class="filter-bar">
                    <div class="filter" filter="quality" value="none">
                        <div class="filter-name">
                            <span>Quality</span>
                        </div>
                        <div class="filter-value"></div>
                        <div class="filter-dropdown">
                            <div class="fd-value"><span class="icon icon-close"></span> None</div>
                            <div class="fd-value" style="color: #FFD700 !important;">Unique</div>
                            <div class="fd-value" style="color: #CF6A32 !important;">Strange</div>
                            <div class="fd-value" style="color: #8650AC !important;">Unusual</div>
                            <div class="fd-value" style="color: #476291 !important;">Vintage</div>
                            <div class="fd-value" style="color: #4D7455 !important;">Genuine</div>
                            <div class="fd-value" style="color: #38F3AB !important;">Haunted</div>
                            <div class="fd-value" style="color: #AA0000 !important;">Collector</div>
                            <div class="fd-value" style="color: #FAFAFA !important;">Decorated</div>
                            <div class="fd-value" style="color: #70B04A !important;">Self-Made</div>
                        </div>
                    </div>
                    <div class="filter" filter="type" value="none">
                        <div class="filter-name">
                            <span>Type</span>
                        </div>
                        <div class="filter-value"></div>
                        <div class="filter-dropdown">
                            <div class="fd-value"><span class="icon icon-close"></span> None</div>
                            <div class="fd-value"><span class="icon icon-hat2"></span> Cosmetic</div>
                            <div class="fd-value"><span class="icon icon-pencil"></span> Weapon</div>
                            <div class="fd-value"><span class="icon icon-autoselect"></span> War Paint</div>
                            <div class="fd-value"><span class="icon icon-group"></span> Taunt</div>
                            <div class="fd-value"><span class="icon icon-wrench"></span> Tool</div>
                        </div>
                    </div>
                    <div class="filter" filter="particle" value="none">
                        <div class="filter-name">
                            <span>Particle</span>
                        </div>
                        <div class="filter-value"></div>
                        <div class="filter-dropdown">
                            
                        </div>
                    </div>
                    <div class="filter" filter="warpaint" value="none">
                        <div class="filter-name">
                            <span>Warpaint</span>
                        </div>
                        <div class="filter-value"></div>
                        <div class="filter-dropdown">
                            <div class="fd-value"><span class="icon icon-close"></span> None</div>
                            <div class="fd-value"><span class="icon icon-desc"></span> Descending</div>
                            <div class="fd-value"><span class="icon icon-asc"></span> Ascending</div>
                        </div>
                    </div>
                    <div class="filter" filter="item-order" value="none">
                        <div class="filter-name">
                            <span>Item Order</span>
                        </div>
                        <div class="filter-value"></div>
                        <div class="filter-dropdown">
                            <div class="fd-value"><span class="icon icon-close"></span> None</div>
                            <div class="fd-value"><span class="icon icon-desc"></span> Descending</div>
                            <div class="fd-value"><span class="icon icon-asc"></span> Ascending</div>
                        </div>
                    </div>
                    <form action="" method="post" class="input-filter" id="user-input-filter">
                        <input type="text" name="" id="" spellcheck="false" placeholder="Search for items ...">
                        <button type="submit"><span class="icon icon-search"></span></button>
                    </form>
                </div>

                <div class="item-content">
                    <div class="item-loader"><img src="/img/trade-icon.jpg" alt=""></div>
                    <div class="items"></div>
                </div>
            </div>
        </main>

        <script>
            document.addEventListener('click', function(e){
                var filterR;
                try {
                    filterR = document.querySelector('.filter.open');
                    document.querySelector('.filter.open').classList.remove('open')
                } catch (error) {}
                let el = e.target;
                if(el.classList[0] == 'filter'){
                    document.querySelectorAll('.filter').forEach((ele) => {
                        if(ele == el){
                            if(filterR == el){

                            } else {
                                el.classList.toggle('open')
                            }
                        } else {
                            ele.classList.remove('open')
                        }
                    })
                }
                if(el.classList.contains('fd-value')){
                    if(el.textContent.trim() == 'None'){
                        el.parentElement.parentElement.classList.remove('selected');
                        el.parentElement.parentElement.querySelector('.filter-value').innerHTML = '';
                    }
                    if(el.textContent.trim() != 'None'){
                        el.parentElement.parentElement.classList.add('selected');
                        el.parentElement.parentElement.querySelector('.filter-value').innerHTML = el.innerHTML;
                        el.parentElement.parentElement.querySelector('.filter-value').setAttribute('style', el.getAttribute('style'))
                    }
                    el.parentElement.parentElement.classList.remove('open');

                    // filter function
                }
            })

            const dropdown = $('.filter[filter="particle"] .filter-dropdown')
            const checkEffectFilter = setInterval(() => {
                if(dropdown.children().length != 0){ clearInterval(checkEffectFilter) }
                fillParticleFilter(JSON.parse(localStorage.getItem('unusual_effects')))
            }
            , 2000
            );

            async function fillParticleFilter(eff_arr){
                if(eff_arr != undefined && dropdown.children().length == 0){
                    dropdown.append(`<div class="fd-value"><span class="icon icon-close"></span> None</div>`)
                    eff_arr.forEach(effect => {
                        dropdown.append(`<div class="fd-value"><img src="https://backpack.tf/images/440/particles/${effect.ID}_94x94.png" style="height: 24px;"> ${effect.name}</div>`)
                    });
                }
            }
        </script>
        
        <%- include('./partials/footer.ejs') %>
    </body>
</html>