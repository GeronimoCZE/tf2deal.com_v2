                "Assassin": "#D32CE6",
                "Elite": "#EB4B4B"
            }
        }

        if(localStorage.getItem('unusual_effects') == null){
            get_particles()
        } else {
            try{ 
                if(JSON.parse(localStorage.getItem('unusual_update')) < (Date.now())){
                    get_particles()
                }
            } catch{}
        }

        async function get_particles(){
            $.ajax({
                "async": true,
                "crossDomain": true,
                "url": '../api/unusual_effects',
                "method": "GET",
                "headers": {
                    "Content-Type": "application/json",
                    "Authorization": "Bearer ",
                    "Accept": "*/*",
                }
            }).done(async function (response) {
                localStorage.setItem('unusual_effects', JSON.stringify(response))
                localStorage.setItem('unusual_update', Date.now() + 1000*60*60*24)
            });
        }
    </script>

