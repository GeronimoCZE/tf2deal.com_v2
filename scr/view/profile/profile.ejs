<!DOCTYPE html>
<html lang="en">
    <%- include('../partials/head.ejs') %>
    <body>
        <%- include('../partials/nav.ejs') %>
        
        <main>
            <div class="page-section profile-ps">
                <div id="widget-box" class="hidden">
                    <div class="widget-content">
                        <!-- Your widget content goes here -->
                        <h2>Welcome to our website!</h2>
                        <p>Thank you for registering.</p>
                    </div>
                </div>
                <style>
                    #widget-box {
                        position: relative;
                        max-width: 50rem;
                        margin: 2rem auto 0rem auto !important;
                        background-color: #2c2c2c;
                        padding: 10px;
                        border: 1px solid #ccc;
                        box-shadow: 0 0 5px rgba(0, 0, 0, 0.2);
                    }
                    #widget-box.hidden{
                        display: none;
                    }
                </style>
                <div class="profile-box">
                    <div class="heading">
                        <span class="title"><span class="icon-user"></span> <%- user.personaname %></span>
                        <a href="/profile/history"><span class="icon-trade1"></span> History</a>
                    </div>
                    <div class="body">
                        <div class="account-card">
                            <img src="<%- user.avatarfull %>" alt="" class="account-avatar">
                            <div class="account-details">
                                <div class="account-name"></div>
                                <div class="detail">
                                    <div class="name">Registered</div>
                                    <div class="value" id="firstlogin"></div>
                                </div>
                                <div class="detail">
                                    <div class="name">Trades</div>
                                    <div class="value" id="trades"><span class="icon icon-trade2"></span> <%- user_db.user.trades %></div>
                                </div>
                                <div class="detail">
                                    <div class="name">Newsletter</div>
                                    <div class="value" id="newsletter"><span class="icon icon-mail"></span> </div>
                                </div>
                                <div class="detail">
                                    <div class="name">Giveaways</div>
                                    <div class="value" id="giveaways"><span class="icon icon-ticket"></span> <%- user_db.user.giveaways.entries %> (<%- user_db.user.giveaways.won %>)</div>
                                </div>
                                <div class="detail">
                                    <div class="name">Premium</div>
                                    <div class="value" id="bonus">

                                        <!-- <span class="true">Active <span class="exp">(expires 04.12.2023)</span></span> -->
                                        <span class="false">None</span></span>
                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="account-links">
                            <div class="link">
                                <div class="header">Trade URL (<a href="https://steamcommunity.com/id/me/tradeoffers/privacy#trade_offer_access_url" target="_blank">GET LINK</a>)</div>
                                <form action="/api/update_user" method="post" id="form-tradeurl">
                                    <input type="text" spellcheck="false">
                                    <button type="submit"><span class="icon icon-checkmark"></span><span class="icon icon-pencil"></span></button>
                                </form>
                            </div>
                            <div class="link">
                                <div class="header">Email (optional)</div>
                                <form action="/api/update_user" method="post" id="form-email">
                                    <input type="text" spellcheck="false">
                                    <button type="submit"><span class="icon icon-checkmark"></span><span class="icon icon-pencil"></span></button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <script type="module" defer>
                    let tradeurl = `<%- (user_db.user.tradelink == 'null') ? ``: user_db.user.tradelink%>`
                    let email = `<%- (user_db.user.email == 'null') ? ``: user_db.user.email %>`;

                    if(window.location.search.includes('new_user=true') && tradeurl == ''){
                        $('#widget-box').removeClass('hidden')
                    }

                    if(tradeurl == '' ){ 
                        iziToast.info({
                            title: 'Info',
                            message: 'Submit your Trade URL',
                            timeout: 10000
                        });
                    }
                    else { 
                        if(sessionStorage.getItem('profile-greating') == null){
                            
                            sessionStorage.setItem('profile-greating', '1')
                        }
                     }

                    if(user_firstlogin != ``){
                        let logon = new Date(Number(`<%- user_db.user.firstlogin %>`))
                        $('#firstlogin').append(logon.toLocaleDateString())
                    } else { $('#firstlogin').append('?') }

                    if(user_tradeurl != ``){
                        document.querySelector('#form-tradeurl input').value = user_tradeurl
                    }
                    if(user_email != ``){
                        document.querySelector('#form-email input').value = user_email
                        $('#newsletter').append('Yes')
                    } else { $('#newsletter').append('No') }
                    document.querySelectorAll('.account-links form').forEach(form => {
                        form.addEventListener('submit', function(e){
                            e.preventDefault()
                            const input = form.querySelector('input').value;

                            if(form.querySelector('button').classList.contains('edit')){
                                form.querySelector('input').removeAttribute('readonly')
                                form.querySelector('button').classList.remove('edit')
                                form.querySelector('input').focus()
                                form.querySelector('input').select()
                            } else {
                                form.querySelector('button').setAttribute('disabled', '')
                                form.querySelector('input').setAttribute('readonly', '')
                                if(form.id == 'form-tradeurl'){
                                    if(input == tradeurl){ 
                                        setTimeout(() => {
                                            form.querySelector('button').removeAttribute('disabled', '')
                                            form.querySelector('button').classList.add('edit')
                                        }, 3000);
                                        return false;
                                    }
                                    if(input == "" || 70 < input.length && 80 > input.length && input.includes(`partner=`) && input.includes(`&token`)){
                                        $.ajax({
                                            "async": true,
                                            "crossDomain": true,
                                            "url": '../api/user/update',
                                            "method": "POST",
                                            "data": JSON.stringify({"tradeurl": (input == "") ? 'null' : input}),
                                            "headers": {
                                                "Content-Type": "application/json",
                                                "Authorization": "Bearer ",
                                                "Accept": "*/*",
                                            }
                                        })
                                        .fail(function(response) {
                                            iziToast.error({
                                                title: 'Error',
                                                message: response.statusText
                                            });
                                            setTimeout(() => {
                                                form.querySelector('button').removeAttribute('disabled', '')
                                                form.querySelector('input').removeAttribute('readonly', '')
                                            }, 10000);
                                        })
                                        .done(async function (response) {
                                            if(response.status == 'OK'){
                                                tradeurl = input
                                                iziToast.success({
                                                    title: 'Success!',
                                                    message: 'Your data has been saved!'
                                                });
                                                setTimeout(() => {
                                                    form.querySelector('button').removeAttribute('disabled', '')
                                                    form.querySelector('button').classList.add('edit')
                                                }, 3000);
                                            } else {
                                                iziToast.error({
                                                    title: 'Error',
                                                    message: response.statusText
                                                });
                                                setTimeout(() => {
                                                    form.querySelector('button').removeAttribute('disabled', '')
                                                    form.querySelector('input').removeAttribute('readonly', '')
                                                }, 3000);
                                            }
                                        })
                                    } else { 
                                        iziToast.warning({
                                            title: 'Wrong input!'
                                        });
                                        setTimeout(() => {
                                            form.querySelector('button').removeAttribute('disabled', '')
                                            form.querySelector('input').removeAttribute('readonly', '')
                                        }, 3000);
                                    }
                                }
                                else if(form.id == 'form-email'){
                                    if(input == email){ 
                                        setTimeout(() => {
                                            form.querySelector('button').removeAttribute('disabled', '')
                                            form.querySelector('button').classList.add('edit')
                                        }, 3000);
                                        return false;
                                    }
                                    let regex = /^\w+([\.-]\w+)*@\w+([\.-]\w+)*(\.\w{2,3})+$/
                                    if(input == "" || regex.test(input)){

                                        $.ajax({
                                            "async": true,
                                            "crossDomain": true,
                                            "url": '../api/user/update',
                                            "method": "POST",
                                            "data": JSON.stringify({"email": (input == "") ? 'null' : input}),
                                            "headers": {
                                                "Content-Type": "application/json",
                                                "Authorization": "Bearer ",
                                                "Accept": "*/*",
                                            }
                                        })
                                        .fail(function(response) {
                                            iziToast.error({
                                                title: 'Error',
                                                message: response.statusText
                                            });
                                            setTimeout(() => {
                                                form.querySelector('button').removeAttribute('disabled', '')
                                                form.querySelector('input').removeAttribute('readonly', '')
                                            }, 10000);
                                        })
                                        .done(async function (response) {
                                            if(response.status == 'OK'){
                                                email = input
                                                iziToast.success({
                                                    title: 'Success!',
                                                    message: 'Your data has been saved!'
                                                });
                                                if(input == '') { $('#newsletter').html($('#newsletter').html().replace('Yes', 'No')) }
                                                else { $('#newsletter').html($('#newsletter').html().replace('No', 'Yes')) }
                                                setTimeout(() => {
                                                    form.querySelector('button').removeAttribute('disabled', '')
                                                    form.querySelector('button').classList.add('edit')
                                                }, 3000);
                                            } else {
                                                iziToast.error({
                                                    title: 'Error',
                                                    message: response.statusText
                                                });
                                                setTimeout(() => {
                                                    form.querySelector('button').removeAttribute('disabled', '')
                                                    form.querySelector('input').removeAttribute('readonly', '')
                                                }, 3000);
                                            }
                                        })
                                    } else { 
                                        iziToast.warning({
                                            title: 'Wrong input!'
                                        });
                                        setTimeout(() => {
                                            form.querySelector('button').removeAttribute('disabled', '')
                                            form.querySelector('input').removeAttribute('readonly', '')
                                        }, 3000);
                                    }
                                }


                            }
                        })

                        if(form.querySelector('input').value != ""){
                            form.querySelector('input').setAttribute('readonly', '')
                            form.querySelector('button').classList.add('edit')
                        }
                    })
                </script>
            </div>
        </main>
        
        <%- include('../partials/footer.ejs') %>
    </body>
</html>