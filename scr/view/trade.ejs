<!DOCTYPE html>
<html lang="en">
    <%- include('./partials/head.ejs') %>
    <body style="position: relative;">

        <%- include('./partials/nav.ejs') %>
        <img src="/img/background.jpg" alt="" style="position: fixed; width: 100%; opacity: .1; top: 0;">
        <main>
            <div class="page-section index-ps">

                <%- include('./partials/item_tooltip.ejs') %>

                <div class="error-output" id="trade-err-output"></div>
                <div class="widget-wrapper">
                    <div class="items-in-trade">
                        <div class="items user-items" id="user-grid">
                            <span class="no-items">No items on your side</span>
                        </div>
                        <div class="status-bar">
                            <div class="total-value">
                                <div class="key-section">
                                    <div class="amount" id="user-key-total">0</div>
                                    <span class="icon icon-key"></span>
                                </div>
                                <div class="ref-section">
                                    <div class="amount" id="user-ref-total">0.00</div>
                                    <span class="icon icon-refined_metal"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="btns">
                        <!-- add class ready when ready -->
                        <div class="btn trade-btn">
                            <span class="trade-btn-span">TRADE</span>
                            <i class="icon icon-trade2"></i>
                            <div class="create-trade-animation">
                                <div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div>
                            </div>
                            <div class="trade-denied">
                                <i class="icon icon-close"></i>
                            </div>
                            <div class="trade-confirmed">
                                <i class="icon icon-checkmark"></i>
                            </div>

                        </div>
                    </div>
                    <div class="items-in-trade">
                        <div class="status-bar">
                            <div class="total-value">
                                <div class="key-section">
                                    <div class="amount" id="site-key-total">0</div>
                                    <span class="icon icon-key"></span>
                                </div>
                                <div class="ref-section">
                                    <div class="amount" id="site-ref-total">0.00</div>
                                    <span class="icon icon-refined_metal"></span>
                                </div>
                            </div>
                        </div>
                        <div class="items site-items" id="site-grid">
                            <span class="no-items">No items on our side</span>
                        </div>
                    </div>
                </div>
                <div class="trade-inv-window user-window">
                    <script>
                        document.addEventListener('click', function(e){
                            var filterR;
                            try {
                                filterR = document.querySelector('.filter.open');
                                document.querySelector('.filter.open').classList.remove('open')
                            } catch (error) {}
                            let el = e.target;
                            if(el.classList[0] == 'filter'){
                                document.querySelectorAll('.filter').forEach((ele) => {
                                    if(ele == el){
                                        if(filterR == el){

                                        } else {
                                            el.classList.toggle('open')
                                        }
                                    } else {
                                        ele.classList.remove('open')
                                    }
                                })
                            }
                            if(el.classList.contains('fd-value')){
                                if(el.textContent.trim() == 'None'){
                                    el.parentElement.parentElement.classList.remove('selected');
                                    el.parentElement.parentElement.querySelector('.filter-value').innerHTML = '';
                                }
                                if(el.textContent.trim() != 'None'){
                                    el.parentElement.parentElement.classList.add('selected');
                                    el.parentElement.parentElement.querySelector('.filter-value').innerHTML = el.innerHTML;
                                    el.parentElement.parentElement.querySelector('.filter-value').setAttribute('style', el.getAttribute('style'))
                                }
                                el.parentElement.parentElement.classList.remove('open');

                                // filter function
                            }
                        })
                    </script>
                    <div class="filters" id="user-filters">
                        <div class="filter-btn" id="filter-btn-user"><span class="icon icon-arrow_down"></span> Filters</div>
                        <div class="filter-box hidden">
                            <!-- quality, type, class, price (asc x desc), input search field -->
                            <div class="filter" filter="quality" value="none">
                                <div class="filter-name">
                                    <span>Quality</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                    <div class="fd-value" style="color: #FFD700 !important;">Unique</div>
                                    <div class="fd-value" style="color: #CF6A32 !important;">Strange</div>
                                    <div class="fd-value" style="color: #8650AC !important;">Unusual</div>
                                    <div class="fd-value" style="color: #476291 !important;">Vintage</div>
                                    <div class="fd-value" style="color: #4D7455 !important;">Genuine</div>
                                    <div class="fd-value" style="color: #38F3AB !important;">Haunted</div>
                                    <div class="fd-value" style="color: #AA0000 !important;">Collector</div>
                                    <div class="fd-value" style="color: #FAFAFA !important;">Decorated</div>
                                    <div class="fd-value" style="color: #70B04A !important;">Self-Made</div>
                                </div>
                            </div>
                            <div class="filter" filter="type" value="none">
                                <div class="filter-name">
                                    <span>Type</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                    <div class="fd-value"><span class="icon icon-hat2"></span> Cosmetic</div>
                                    <div class="fd-value"><span class="icon icon-pencil"></span> Weapon</div>
                                    <div class="fd-value"><span class="icon icon-autoselect"></span> War Paint</div>
                                    <div class="fd-value"><span class="icon icon-group"></span> Taunt</div>
                                    <div class="fd-value"><span class="icon icon-wrench"></span> Tool</div>
                                </div>
                            </div>
                            <div class="filter" filter="particle" value="none">
                                <div class="filter-name">
                                    <span>Particle</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                </div>
                            </div>
                            <div class="filter" filter="warpaint" value="none">
                                <div class="filter-name">
                                    <span>Warpaint</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                    <div class="fd-value"><span class="icon icon-desc"></span> Descending</div>
                                    <div class="fd-value"><span class="icon icon-asc"></span> Ascending</div>
                                </div>
                            </div>
                            <div class="filter" filter="item-order" value="none">
                                <div class="filter-name">
                                    <span>Order</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                    <div class="fd-value"><span class="icon icon-desc"></span> Descending</div>
                                    <div class="fd-value"><span class="icon icon-asc"></span> Ascending</div>
                                </div>
                            </div>
                            <div class="filter" filter="price" value="none">
                                <div class="filter-name">
                                    <span>Price</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                    <div class="fd-value">0 - 1 <span class="icon icon-key"></span></div>
                                    <div class="fd-value">1 - 5 <span class="icon icon-key"></span></div>
                                    <div class="fd-value">5 - 12 <span class="icon icon-key"></span></div>
                                    <div class="fd-value">12 - 25 <span class="icon icon-key"></span></div>
                                    <div class="fd-value">25 - 50 <span class="icon icon-key"></span></div>
                                    <div class="fd-value">50+ <span class="icon icon-key"></span></div>
                                </div>
                            </div>
                            <div class="reset-filters">reset all</div>

                        </div>
                        <form action="" method="post" class="input-filter" id="user-input-filter">
                            <input type="text" name="" id="" spellcheck="false" placeholder="Search for items ...">
                            <button type="submit"><span class="icon icon-search"></span></button>
                        </form>
                    </div>
                    <div class="items" items-loaded="false">
                        <% if(user){ %>
                            <!-- once items loaded -> save in localstorage -> refresh on button click (rate limit / minute) -->
                            <div class="loading-items" id="user-loading">
                                <span class="loader"></span>
                                <span class="loader-text">Loading inventory</span>
                                <span class="loader-text-small">This might take a few seconds</span>
                            </div>
                            <div class="item-grid" id="user-item-grid">
                                <!-- load items here -->
                            </div>
                            <script type="application/javascript">
                                /* make inv fetch client sided! => send data to server => process => render */
                                /* deploy cors-anywhere server */
    
                                let user_inv_anim = document.querySelector('body > main > div > div.trade-inv-window.user-window > div.items > div.loading-items.user-el');
    
                                $('#reload-btn').click(function(){
                                    $(this).toggleClass('animate')
                                    user_inv_anim.classList.toggle('hidden')
                                    setTimeout(function(){
                                        $('#reload-btn').toggleClass('animate')
                                        user_inv_anim.classList.toggle('hidden')
                                    }, 5000)
                                })
                            </script>
                        <% } else { %>
                            <%- include('./partials/login_btn.ejs') %>
                            <style>
                                .user-window .items{
                                    align-items: center !important;
                                    justify-content: center !important;
                                }
                            </style>
                        <% } %>
                    </div>
                </div>
                <div class="trade-inv-window site-window">
                    <div class="filters" id="site-filters">
                        <div class="filter-btn" id="filter-btn-site"><span class="icon icon-arrow_down"></span> Filters</div>
                        <div class="filter-box hidden">
                            <!-- quality, type, class, price (asc x desc), input search field -->
                            <div class="filter" filter="quality" value="none">
                                <div class="filter-name">
                                    <span>Quality</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                    <div class="fd-value" style="color: #FFD700 !important;">Unique</div>
                                    <div class="fd-value" style="color: #CF6A32 !important;">Strange</div>
                                    <div class="fd-value" style="color: #8650AC !important;">Unusual</div>
                                    <div class="fd-value" style="color: #476291 !important;">Vintage</div>
                                    <div class="fd-value" style="color: #4D7455 !important;">Genuine</div>
                                    <div class="fd-value" style="color: #38F3AB !important;">Haunted</div>
                                    <div class="fd-value" style="color: #AA0000 !important;">Collector</div>
                                    <div class="fd-value" style="color: #FAFAFA !important;">Decorated</div>
                                    <div class="fd-value" style="color: #70B04A !important;">Self-Made</div>
                                </div>
                            </div>
                            <div class="filter" filter="type" value="none">
                                <div class="filter-name">
                                    <span>Type</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                    <div class="fd-value"><span class="icon icon-hat2"></span> Cosmetic</div>
                                    <div class="fd-value"><span class="icon icon-pencil"></span> Weapon</div>
                                    <div class="fd-value"><span class="icon icon-autoselect"></span> War Paint</div>
                                    <div class="fd-value"><span class="icon icon-group"></span> Taunt</div>
                                    <div class="fd-value"><span class="icon icon-wrench"></span> Tool</div>
                                </div>
                            </div>
                            <div class="filter" filter="particle" value="none">
                                <div class="filter-name">
                                    <span>Particle</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                </div>
                            </div>
                            <div class="filter" filter="warpaint" value="none">
                                <div class="filter-name">
                                    <span>Warpaint</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                    <div class="fd-value"><span class="icon icon-desc"></span> Descending</div>
                                    <div class="fd-value"><span class="icon icon-asc"></span> Ascending</div>
                                </div>
                            </div>
                            <div class="filter" filter="item-order" value="none">
                                <div class="filter-name">
                                    <span>Order</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                    <div class="fd-value"><span class="icon icon-desc"></span> Descending</div>
                                    <div class="fd-value"><span class="icon icon-asc"></span> Ascending</div>
                                </div>
                            </div>
                            <div class="filter" filter="price" value="none">
                                <div class="filter-name">
                                    <span>Price</span>
                                </div>
                                <div class="filter-value"></div>
                                <div class="filter-dropdown">
                                    <div class="fd-value"><span class="icon icon-close"></span> None</div>
                                    <div class="fd-value">0 - 1 <span class="icon icon-key"></span></div>
                                    <div class="fd-value">1 - 5 <span class="icon icon-key"></span></div>
                                    <div class="fd-value">5 - 12 <span class="icon icon-key"></span></div>
                                    <div class="fd-value">12 - 25 <span class="icon icon-key"></span></div>
                                    <div class="fd-value">25 - 50 <span class="icon icon-key"></span></div>
                                    <div class="fd-value">50+ <span class="icon icon-key"></span></div>
                                </div>
                            </div>
                            <div class="reset-filters">reset all</div>

                        </div>

                        <form action="" method="post" class="input-filter" id="site-input-filter">
                            <input type="text" name="" id="" spellcheck="false" placeholder="Search for items ...">
                            <button type="submit"><span class="icon icon-search"></span></button>
                        </form>
                    </div>
                    <div class="items" items-loaded="false">
                        <div class="loading-items" id="site-loading">
                            <span class="loader"></span>
                            <span class="loader-text">Loading inventory</span>
                            <span class="loader-text-small">This might take a few seconds</span>
                        </div>
                        <div class="item-grid" id="site-item-grid">
                            <!-- load items here -->
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <script>
            
            const user_particle_dropdown = $('.user-window .filter[filter="particle"] .filter-dropdown')
            const site_particle_dropdown = $('.site-window .filter[filter="particle"] .filter-dropdown')
            const checkEffectFilter = setInterval(() => {
                if(site_particle_dropdown.children().length != 1){ clearInterval(checkEffectFilter) }
                fillParticleFilter(JSON.parse(localStorage.getItem('unusual_effects')))
            }
            , 2000
            );

            async function fillParticleFilter(eff_arr){
                if(eff_arr != undefined && site_particle_dropdown.children().length == 1){
                    eff_arr.forEach(effect => {
                        site_particle_dropdown.append(`<div class="fd-value" style="overflow-wrap: break-word;"><img src="https://backpack.tf/images/440/particles/${effect.ID}_94x94.png" style="height: 24px;"> ${effect.name}</div>`)
                        user_particle_dropdown.append(`<div class="fd-value" style="overflow-wrap: break-word;"><img src="https://backpack.tf/images/440/particles/${effect.ID}_94x94.png" style="height: 24px;"> ${effect.name}</div>`)
                    });
                }
            }

            document.querySelectorAll('.filter-btn').forEach((btn) => {
                btn.addEventListener('click', () => {
                    btn.parentElement.querySelector('.filter-box').classList.toggle('hidden')
                    btn.classList.toggle('active')
                })
            })
        </script>
        
        <%- include('./partials/footer.ejs') %>
    </body>
</html>
