<!-- This is trade view -->
<!DOCTYPE html>
<html lang="en">
    <%- include('./partials/head.ejs') %>
    <body>
        <%- include('./partials/nav.ejs') %>

        <!-- place here trade offer notification (full width / ~second nav) -->

        <main>
            <div class="page-section index-ps" style="flex-direction: column !important; align-items: center !important;">
                <h2 style="font-weight: bold;">You have been timeouted!</h2>
                <br>
                <p>Modifying HTML 'data-' attributes is prohibited and will lead to a trade timeout.</p>
                <br>
                <p>Your timeout ends:</p>
                <div id="timeout-expiration" style="font-weight: bold;"></div>
                <script>
                    const timeoutExp = Number('<%- info.timeout.expiration %>')
                    const date = new Date(timeoutExp);

                    document.querySelector('#timeout-expiration').textContent = date.toLocaleDateString() + " at " + date.toLocaleTimeString();
                </script>
            </div>
        </main>
        
        <%- include('./partials/footer.ejs') %>

        <script type="application/javascript">

            fetch('http://ip-api.com/json/')
                .then(function (response) {
                    return response.json();
                })
                .then(function (payload) {
                    console.log(payload);
                });
    
            // set language
        </script>
    </body>
</html>