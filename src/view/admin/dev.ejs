            </div>
            <script type="module" defer>
                const delay = (milliseconds) => new Promise((resolve) => setTimeout(resolve, milliseconds));
                const particles = JSON.parse(localStorage.getItem('unusual_effects'));
                const bp_sugs = []
                const scm_sugs = []

                let new_bot = {
                    type: null,
                    id: null,
                    name: null,
                    password: null,
                    identitySecret: null,
                    sharedSecret: null,
                    bptf_key: null,
                    bptf_token: null
                }

                document.addEventListener('DOMContentLoaded', () => {
                    const tabs = document.querySelectorAll('.admin-container nav ul li a');
                    const contents = document.querySelectorAll('.admin-container .tab-content');

                    tabs.forEach(tab => {
                        if(window.location.hash == tab.getAttribute('href')){
                            tabs.forEach(item => item.classList.remove('active'));
                            contents.forEach(content => content.classList.remove('active'));

                            tab.classList.add('active');
                            document.querySelector(tab.getAttribute('href')).classList.add('active');
                            window.location.hash = tab.getAttribute('href');
                            document.title = tab.textContent + " - Admin Page";
                        }
                        tab.addEventListener('click', (event) => {
                            event.preventDefault();

                            tabs.forEach(item => item.classList.remove('active'));
                            contents.forEach(content => content.classList.remove('active'));

                            tab.classList.add('active');
                            document.querySelector(tab.getAttribute('href')).classList.add('active');
                            window.location.hash = tab.getAttribute('href');
                            document.title = tab.textContent + " - Admin Page";
                        });
                    });

                    $('#add-bot').click((e) => {
                        iziToast.show({
                        theme: 'dark',
                        icon: 'icon-steam_rectangle',
                        title: 'New Bot',
                        message: 'Add a new steam trading bot!',
                        position: 'center', // bottomRight, bottomLeft, topRight, topLeft, topCenter, bottomCenter
                        maxWidth: '300px',
                        overlay: true,
                        progressBar: false,
                        timeout: false,
                        inputs: [
                            ['<input type="text" placeholder="type">', 'input', function (instance, toast, input, e) {
                                new_bot[e.target.getAttribute('placeholder')] = e.target.value
                                console.log(new_bot)
                            }],
                            ['<input type="text" placeholder="id">', 'input', function (instance, toast, input, e) {
                                new_bot[e.target.getAttribute('placeholder')] = e.target.value
                                console.log(new_bot)
                            }],
                            ['<input type="text" placeholder="name">', 'input', function (instance, toast, input, e) {
                                new_bot[e.target.getAttribute('placeholder')] = e.target.value
                                console.log(new_bot)
                            }],
                            ['<input type="text" placeholder="password">', 'input', function (instance, toast, input, e) {
                                new_bot[e.target.getAttribute('placeholder')] = e.target.value
                                console.log(new_bot)
                            }],
                            ['<input type="text" placeholder="identitySecret">', 'input', function (instance, toast, input, e) {
                                new_bot[e.target.getAttribute('placeholder')] = e.target.value
                                console.log(new_bot)
                            }],
                            ['<input type="text" placeholder="sharedSecret">', 'input', function (instance, toast, input, e) {
                                new_bot[e.target.getAttribute('placeholder')] = e.target.value
                                console.log(new_bot)
                            }],
                            ['<input type="text" placeholder="bptf_key">', 'input', function (instance, toast, input, e) {
                                new_bot[e.target.getAttribute('placeholder')] = e.target.value
                                console.log(new_bot)
                            }],
                            ['<input type="text" placeholder="bptf_token">', 'input', function (instance, toast, input, e) {
                                new_bot[e.target.getAttribute('placeholder')] = e.target.value
                                console.log(new_bot)
                            }]
                        ],
                        buttons: [
                            ['<button>Confirm</button>', function (instance, toast) {
                                console.log('bot: ', new_bot)
                                fetch('/api/new_bot', {
                                    method: 'POST',
                                    body: JSON.stringify({bot: new_bot}),
                                    headers:{
                                        "Content-Type": "application/json",
                                        "Authorization": "Bearer ",
                                        "Accept": "*/*",
                                    }
                                }).then(async (res) => {  
                                    if(res.ok){
                                        return res.json() 
                                    } else {
                                        iziToast.error({
                                            timeout: 3000,
                                            title: 'Error',
                                                message: 'json:error?'
                                        });
                                        return;
                                    }
                                    })
                                .then(jsonResponse => {
                                    if(jsonResponse?.status == 'ok'){
                                        
                                        instance.hide({
                                            transitionOut: 'fadeOutUp',
                                            onClosing: function(instance, toast, closedBy){
                                                // The return will be: 'closedBy: buttonName'
                                                iziToast.success({
                                                    timeout: 3000,
                                                    title: 'Success',
                                                        message: 'New bot added.'
                                                });
                                                new_bot = {
                                                    type: null,
                                                    id: null,
                                                    password: null,
                                                    identitySecret: null,
                                                    sharedSecret: null,
                                                    bptf_key: null,
                                                    bptf_token: null
                                                }
                                            }
                                        }, toast, 'buttonName');
                                    } else {
                                        iziToast.error({
                                            timeout: 3000,
                                            title: 'Error',
                                                message: 'status:error?'
                                        });
                                    }
                                }).catch(async(e) => {
                                    iziToast.error({
                                            timeout: 3000,
                                            title: 'Error',
                                                message: 'catch?'
                                        });
                                })
                            }]
                        ]
                    });

                    })
                });

                suggestion_view()
                async function effect_view(){               
                    $('.suggestion-results').addClass('hidden')
                    $('.admin-data').children().remove();
                    for (const effect of particles) {
                        let type = '';
                        if(Number(effect["ID"]) < 3000 && !["701","702","703","704"].includes(effect["ID"])){ type = 'cosmetic' }
                        else if(Number(effect["ID"]) >= 3000){ type = 'taunt' }
                        else if(["701","702","703","704"].includes(effect["ID"])){ type = 'weapon' }

                        $('.admin-data').append(`<div class='item-instance'>
                            <img class='image' src='https://backpack.tf/images/440/particles/${effect["ID"]}_94x94.png' loading="lazy"> 
                            <span class='type'>${type}</span>
                            <span class='name'>${effect.name}</span>
                            ${(effect.active == 'true') ? '<div class="btn remove">Remove</div>':'<div class="btn add">Add</div>'}
                        </div>`)
                    }
                }

                async function suggestion_view(){
                    $('.suggestion-results').removeClass('hidden')
                    $('.admin-data').children().remove();

                    const selectedItems = new Map()
                    var suggestions = []

                    const killstreaks = [' ', ' Killstreak ', ' Specialized Killstreak ', ' Professional Killstreak ']
                    const particles = {
                        cosmetic: JSON.parse(localStorage.getItem('unusual_effects')).filter((effect) => Number(effect["ID"]) < 3000 && !["701","702","703","704"].includes(effect["ID"])).map(eff => Object({name: eff.name, id: eff['ID']})),
                        taunt: JSON.parse(localStorage.getItem('unusual_effects')).filter((effect) => Number(effect["ID"]) >= 3000).map(eff => Object({name: eff.name, id: eff['ID']})),
                        weapon: JSON.parse(localStorage.getItem('unusual_effects')).filter((effect) => ["701","702","703","704"].includes(effect["ID"])).map(eff => Object({name: eff.name, id: eff['ID']}))
                    }
                    const wears = ['Factory New', 'Minimal Wear', 'Field-Tested', 'Well-Worn', 'Battle Scarred'];

                    let suggestion_settings = {
                        "async": true,
                        "crossDomain": false,
                        "url": '/admin/suggestions',
                        "method": "GET",
                        "headers": {
                            "Content-Type": "application/json",
                            "Authorization": "Bearer ",
                            "Accept": "*/*",
                        }
                    }
                    $.ajax(suggestion_settings)
                    .fail(function( data ) {
                        if(data.statusText != undefined){
                            iziToast.error({
                                title: 'Error!',
                                message: data.statusText
                            });
                        } else {
                            iziToast.error({
                                title: 'Error!',
                                message: `Something has failed`
                            });
                        }
                    })
                    .done(function( data ) {
                        suggestions = data;
                        $('.suggestion-results').children().remove();
                        
                        if(suggestions.length == 0){ $('.suggestion-results').append('not created yet... wait'); return false; }
                        suggestions.forEach((sug, index) => {
                            // api.backpack_tf.in_use = true
                            let instances = []
                            let hide = ''
                            let classes = ''
                            let grade = 'none'

                            if(sug.hasOwnProperty('prices')){
                                for (let i = 0; i < sug.prices.qualities.length; i++) {
                                    for (let y = 0; y < sug.prices.craftability[i].length; y++) {
                                        let craft = (sug.prices.craftability[i][y] == 'Craftable') ? '':'Non-Craftable '
                                        let quality = sug.prices.qualities[i]
                                        let color = itemAttr.Quality[sug.prices.qualities[i]].color
                                        let name = craft + sug.name
                                        
                                        instances.push(`<div class="inst-row q-${quality}"><span style="color: #${color}">${name}</span> </div>`)
                                    }
                                }
                            }

                            if(sug.type != 'tool'){ classes = (sug.hasOwnProperty('classes') && sug.classes != null) ? sug.classes.join(', '):'All classes' }
                            if(sug.hasOwnProperty('grade')) { grade = itemAttr.Grades[sug.grade] }
                            if(index >= 20){ hide = 'hidden'}
                            $('.suggestion-results').append(
                                `<div class="result res-${index} ${sug.name.replaceAll(' ', '_').replaceAll('\n', '_').replaceAll(".", 'D').replaceAll("'", 'i').replaceAll(":", 'f').replaceAll("!", 'l').replaceAll("(", 'L').replaceAll(")", 'R').replaceAll("?", 'Q')}">
                                    <img src="${sug.image[0]}" alt="">
                                    <div class="result-data">
                                        <div class="item-name">${sug.name}</div>
                                        <div class="item-attr">
                                            <div class="attr type" style='color: ${grade}'>${sug.type}</div>
                                            <div class="attr classes">${classes}</div>
                                            <div class="attr method">${sug.method}</div>
                                        </div>
                                        <div class="item-instances">
                                            <div class="instance">...</div>
                                        </div>
                                    </div>
                                    <div class="item-instances-details">
                                        
                                    </div>
                                </div>`
                            )
                        });
                    }).then(
                        async function(){
                            $('.admin-data').children().remove();

                            let item_instances = {
                                "approved": [],
                                "failed": []
                            }

                            // weapon skins & australiums ignores 'Festivized ' in name. (-> may add some price bonus)
                            console.log(particles)

                            function push_instance(sug, i, kt, craft, quality, qualityID, color, australium, effect_id, effect_name){
                                let name = sug.name
                                if(sug.name.startsWith('The ')){
                                    if(sug.prices.qualities[i] != 6 || kt != 0 || craft != ''){ 
                                        name = name.replace('The ', '')
                                    }
                                }
                                let bp_sku = craft + quality + killstreaks[kt] + name
                                if(sug.name.startsWith('Festivized ')){ 
                                    name = name.replace('Festivized ', '')
                                    bp_sku = craft + quality + ' Festivized ' + killstreaks[kt] + name
                                }

                                if(qualityID == 5){
                                    bp_sku = bp_sku.replace(quality, effect_name)
                                }

                                if(bp_sku.startsWith(' ')){ bp_sku = bp_sku.slice(1) }
                                bp_sku = bp_sku.replaceAll('  ', ' ')
                                bp_sku = bp_sku.replaceAll('   ', ' ')
                                bp_sku = bp_sku.replaceAll('    ', ' ')

                                if(sug.type != 'crate'){
                                    let steam_sku = bp_sku.replace('Non-Craftable ', '')
                                    bp_sugs.push({
                                        name: sug.name,
                                        bp_sku: bp_sku,
                                        steam_sku: steam_sku,
                                        quality: quality,
                                        qualityID: sug.prices.qualities[i],
                                        color: color,
                                        image: sug.image[0],
                                        defindex: sug.defindex,
                                        type: sug.type,
                                        craft: craft,
                                        australium: australium,
                                        kt: 0,
                                        effect_id: 0,
                                        effect_name: quality,
                                        method: sug.method
                                    })
                                } else {
                                    for (const serie of sug.series) {
                                        // scm - crate, cooler, strongbox (has ' Series #66')
                                        let crate_bp_sku = String(bp_sku + ` #${serie}`)
                                        let crate_steam_sku = String(bp_sku)
                                        if(['Crate', 'Cooler', 'Strongbox'].some((crate_type) => bp_sku.includes(crate_type))){
                                            crate_steam_sku = String(bp_sku  + ` Series #${serie}`)
                                        }
                                        if(serie == 0){
                                            crate_bp_sku = String(bp_sku)
                                            crate_steam_sku = String(bp_sku)
                                        }
                                        bp_sugs.push({
                                            name: sug.name,
                                            bp_sku: crate_bp_sku,
                                            steam_sku: crate_steam_sku,
                                            quality: quality,
                                            qualityID: sug.prices.qualities[i],
                                            color: color,
                                            image: sug.image[0],
                                            defindex: sug.defindex,
                                            type: sug.type,
                                            craft: craft,
                                            australium: australium,
                                            kt: 0,
                                            effect_id: 0,
                                            effect_name: quality,
                                            method: sug.method
                                        })
                                    }
                                }
                            }

                            function push_instance_scm(sug){
                                switch (sug.type) {
                                    case 'weapon skin':
                                        let qualities = ['15', '11', '5']
                                        for (const qualityID of qualities) {
                                            for (const wear of wears) {
                                                if(qualityID == '5'){
                                                    for (let p = 0; p < particles.weapon.length; p++) {
                                                        do_push('', qualityID, 0, ` (${wear})`, particles.weapon[p].id, particles.weapon[p].name)
                                                    }
                                                } else {
                                                    for (let i = 0; i < 4; i++) {
                                                        do_push('', qualityID, i, ` (${wear})`, 0, '')
                                                    }
                                                }
                                            }
                                        }
                                        break;
                                    case 'war paint':
                                        let qualitie = ['15', '11', '5']
                                        for (const qualityID of qualitie) {
                                            for (const wear of wears) {
                                                if(qualityID == '5'){
                                                    for (let p = 0; p < particles.weapon.length; p++) {
                                                        do_push('', qualityID, 0, ` (${wear})`, particles.weapon[p].id, particles.weapon[p].name)
                                                    }
                                                } else {
                                                    do_push('', qualityID, 0, ` (${wear})`, 0, '')
                                                }
                                            }
                                        }
                                        break;
                                    case 'tool unusualifier':
                                        do_push('Non-Craftable ', "5", 0, '', 0, '')
                                        break;
                                    case 'tool strangifier':
                                        do_push('', "6", 0, '', 0, '')
                                        break;
                                    case 'tool kit':
                                        do_push('Non-Craftable ', "6", 0, '', 0, '')
                                        break;
                                    default:
                                        break;
                                }

                                function do_push(craft, qualityID, kt, wear, effect_id, effect_name){
                                    let quality = (["6", "15"].includes(qualityID)) ? '':itemAttr.Quality[qualityID].name + ' ';
                                    let bp_sku = String(craft + quality + killstreaks[kt] + sug.name + wear).replaceAll('  ', ' ').replaceAll('   ', ' ').replaceAll('    ', ' ');
                                    let steam_sku = String(quality + killstreaks[kt] + sug.name + wear).replaceAll('  ', ' ').replaceAll('   ', ' ').replaceAll('    ', ' ');

                                    if(bp_sku.startsWith(' ')){ bp_sku = bp_sku.slice(1) }
                                    if(steam_sku.startsWith(' ')){ steam_sku = steam_sku.slice(1) }
                                    if(quality == 'Unusual ' && effect_name != ''){ bp_sku = bp_sku.replace('Unusual', effect_name)}
                                    if(quality == 'Unusual ' && sug.name.endsWith('Unusualifier')){ 
                                        bp_sku = bp_sku.replace('Unusual ', '')
                                        steam_sku = steam_sku.replace('Unusual ', '')
                                    }

                                    scm_sugs.push({
                                        name: sug.name,
                                        bp_sku: bp_sku,
                                        steam_sku: steam_sku,
                                        quality: quality,
                                        qualityID: qualityID,
                                        color: itemAttr.Quality[qualityID].color,
                                        craft: craft,
                                        australium: "-1",
                                        image: sug.image[0],
                                        defindex: sug.defindex,
                                        type: sug.type,
                                        kt: kt,
                                        effect_id: effect_id,
                                        effect_name: effect_name,
                                        method: sug.method
                                    })
                                }
                            }

                            for (const [ii,sug] of suggestions.entries()) {
                                if(['bp', 'bp-mixed'].includes(sug?.method) && sug.hasOwnProperty('prices')){
                                    for (let i = 0; i < sug.prices.qualities.length; i++) {
                                        for (let y = 0; y < sug.prices.craftability[i].length; y++) {
                                            // need to use promise based loop!
                                            let craft = (sug.prices.craftability[i][y] == 'Craftable') ? '':'Non-Craftable '
                                            let australium = (sug.name.includes('Australium') && sug.prices.qualities[i] == '11') ? '1':'-1'
                                            let quality = (["6", "15"].includes(sug.prices.qualities[i])) ? '':itemAttr.Quality[sug.prices.qualities[i]].name + ' '
                                            let color = itemAttr.Quality[sug.prices.qualities[i]].color
                                            
                                            push_instance(sug, i, 0, craft, quality, sug.prices.qualities[i], color, australium, 0, quality)
                                            
                                            if(sug.type == 'weapon'){
                                                for (let k = 1; k < 4; k++) {
                                                    push_instance(sug, i, k, craft, quality, sug.prices.qualities[i], color, australium, 0, quality)
                                                }
                                            }
                                            if(sug.type == 'cosmetic' && sug.prices.qualities[i] == 5){
                                                for (let p = 0; p < particles.cosmetic.length; p++) {
                                                    push_instance(sug, i, 0, craft, quality, sug.prices.qualities[i], color, australium, particles.cosmetic[p].id, particles.cosmetic[p].name)
                                                }
                                            }
                                            if(sug.type == 'taunt' && sug.prices.qualities[i] == 5){
                                                for (let p = 0; p < particles.taunt.length; p++) {
                                                    push_instance(sug, i, 0, craft, quality, sug.prices.qualities[i], color, australium, particles.taunt[p].id, particles.taunt[p].name)
                                                }
                                            }
                                        }
                                    }
                                }
                                else{
                                    push_instance_scm(sug)
                                }
                            }
                            console.log(bp_sugs, scm_sugs)
                            $('.suggestions-done .total').text((bp_sugs.length + scm_sugs.length).toLocaleString())

                                /* $.ajax({
                                    "async": true,
                                    "crossDomain": true,
                                    "url": `http://46.101.135.110/search?sku=${sku}`,
                                    "method": "GET",
                                    "headers": {
                                        "Content-Type": "application/json",
                                        "Authorization": "Bearer ",
                                        "Accept": "/*",
                                    }
                                })
                                .fail(async function (response){})
                                .done(async function (res){
                                    console.log(res)
                                    let status = 'ok'
                                    
                                    if(res.hasOwnProperty('message')){ 
                                        status = 'error'
                                    } else {                                                    
                                        const buyListings = new Map()
                                        const sellListings = new Map()
                                        // filter listings
                                        if(res.hasOwnProperty('listings')){
                                            //filter_listings(listings.buy.items)
                                            
                                            
                                        }

                                        async function filter_listings(bp_listings){
                                            let ii = 0;
                                            for (const listing of bp_listings) {
                                                if(listing.item.attributes == undefined){
