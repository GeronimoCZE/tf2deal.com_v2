<!DOCTYPE html>
<html lang="<%= html_lang %>">
    <%- include('../partials/head.ejs') %>
    <body>
        <%- include('../partials/nav.ejs') %>
        
        <main>
            <!-- interface to add items through users inventory (classid, img, desc) -->

            <!-- Quick stats for current day (Approximate profit, Amount of Trades, Users online) -->
            <!-- Bot administration (Add, Remove, Edit and View specific bot - active trades, inv space, status) -->
            <!-- Trade history (with specific day look-up, specific trade details - items, userID, time) -->
            <!-- Items administration (Add, Remove and Edit tradeble items / item types) -->
            <!-- Users administration (View User Stats, Ban Users) -->

            <div class="page-section admin-ps">
                <div class="admin-container">
                    <nav>
                        <ul>
                            <li><a href="#overview" class="active">Overview</a></li>
                            <li><a href="#items">Items</a></li>
                            <li><a href="#bots">Bots</a></li>
                        </ul>
                    </nav>
                    <main>
                        <section id="overview" class="tab-content active">
                            <h1>Overview</h1>
                            <div class="statistics">
                                <div class="stat">
                                    <h3>Total Items</h3>
                                    <p>678</p>
                                </div>
                                <div class="stat">
                                    <h3>Available Items</h3>
                                    <p>456</p>
                                </div>
                                <div class="stat">
                                    <h3>Out of Stock</h3>
                                    <p>222</p>
                                </div>
                            </div>
                            <div class="content-section">
                                <h2>Summary</h2>
                                <div class="content">This is the overview summary content.</div>
                            </div>
                            <div class="content-section">
                                <h2>Statistics</h2>
                                <div class="content">This is the overview statistics content.</div>
                            </div>
                        </section>
                        <section id="bots" class="tab-content">
                            <script>
                                function showBotProfile(botName) {
                                    // Hide all tab contents
                                    document.querySelectorAll('.admin-container .tab-content').forEach(content => {
                                        content.classList.remove('active');
                                    });
                                    // Show bot profile tab
                                    document.getElementById('bot-profile').classList.add('active');
                                    // Set bot profile content
                                    document.getElementById('bot-name').textContent = botName;
                                    document.getElementById('bot-profile-content').textContent = `This is the profile for ${botName}.`;
                                    // Update page title
                                    document.title = botName + " Profile - Admin Page";
                                }

                                function goBackToBots() {
                                    // Show bots tab
                                    document.getElementById('bots').classList.add('active');
                                    // Hide bot profile tab
                                    document.getElementById('bot-profile').classList.remove('active');
                                    // Update page title
                                    document.title = "Bots - Admin Page";
                                }
                            </script>
                            <h1>Bots</h1>
                            <!-- Bots table -->
                             <div class="bots-nav" style="display: flex; flex-direction: row; justify-content: flex-end;">
                                <button id="add-bot">Add Bot</button>
                             </div>
                            <div class="bots-table">
                                <div class="table-header">
                                    <div class="cell _id">id</div>
                                    <div class="cell _name">Steam name</div>
                                    <div class="cell _classifieds">BPTFListings</div>
                                    <div class="cell _steamid">Steamid</div>
                                    <div class="cell _trades">Trades</div>
                                    <div class="cell _items">Items</div>
                                </div>
                                <div class="table-content">
<!-- z -->
                                </div>
                            </div>
            
                        </section>
                        <section id="bot-profile" class="tab-content">
                            <a href="#" class="back-button" onclick="goBackToBots()">Back to Bots</a>
                            <h1>Bot Profile</h1>
                            <div class="content-section">
                                <h2 id="bot-name">Bot Name</h2>
                                <div class="content" id="bot-profile-content">
                                    <!-- Dynamic bot profile content will be inserted here -->
                                </div>
                            </div>
                        </section>
                        <section id="items" class="tab-content">
                            <h1>Items</h1>
                            <div class="content-nav">
                                <div class="cn-item">Items</div>
