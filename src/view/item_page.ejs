<!DOCTYPE html>
<html lang="<%= html_lang %>">
    <script>
        const item = <%- JSON.stringify(info.item ?? null).replace(/</g, '\\u003c') %>;
        const itemClasses = <%- JSON.stringify(info.item?.classes ?? null).replace(/</g, '\\u003c') %>;
        const itemKey = <%- JSON.stringify(info.item?.bptf_data?.update_key_price ?? null).replace(/</g, '\\u003c') %>;
        const itemBuy = <%- JSON.stringify(info.item?.buy ?? null).replace(/</g, '\\u003c') %>;
        const itemSell = <%- JSON.stringify(info.item?.sell ?? null).replace(/</g, '\\u003c') %>;
        const itemStock = <%- JSON.stringify(info.item?.stock ?? null).replace(/</g, '\\u003c') %>;
        // a killstreak tier's page (/items/Professional Killstreak ...) opens with that tier picked
        const itemKsTier = <%- JSON.stringify(info.ks_tier || 0) %>;
        // a weapon's killstreak tiers are items of their own: tier -> the name of its page (null for other items)
        const itemTierPages = <%- JSON.stringify(info.tier_pages || null).replace(/</g, '\\u003c') %>;
        // the item's versions with a price of their own (paints, festivized, spells):
        // [{ kind, name, buy, sell, limit, held, updated }] (service/variants.js)
        const itemVariants = <%- JSON.stringify(info.variants || []).replace(/</g, '\\u003c') %>;
    </script>
    <%- include('./partials/head.ejs') %>
    <body class="<%= season_class %>">
        <%- include('./partials/nav.ejs') %>
        
        <div class="main-wrapper">
            <%- include('./partials/chat.ejs') %>
        
            <main>
                <div class="page-section item-page">
                    <%- include('./partials/item_tooltip.ejs') %>
                    <!-- users can report bad sell / buy price => reports save to db (show in admin panel) -->
                        <div class="navigation">
                            <a href="<%= lurl('/items') %>"><%= __('nav.items') %></a>
                            <span class="spoiler">/</span>
                            <span class="current-item"><a href="#"><%= info.page_name || info.item?.bp_sku %></a></span>
                        </div>

                        <% if(info.item?.status == 0){ %>
                            <div class="inactive-item">
                                <h4><%= __('item.inactive') %></h4>
                                <span><%= __('item.inactive_hint') %></span>
                            </div>
                        <% } %>

                        <div class="item-view active fade-in">
                            <div class="item-body">
                                <!-- <div class="item-header">
                                    Item Overview
                                </div> -->
                                <div class="image-box q-<%= info.item?.qualityID %>">
                                    <img src="<%= info.item?.image_large %>" alt="<%= item_alt(info.item) %>" class="image" fetchpriority="high" effect-id="<%= info.item?.effectID %>">
                                    <div class="btns">
                                        <button id="wishlist-btn"><%= __('item.wishlist') %></button>
                                    </div>
                                </div>
                                <div class="item-details">
                                    <h1 class="item-name" id="item-name" translate="no"><%= info.page_name || info.item?.bp_sku %></h1>
                                    <%# what the item costs to buy and sell, in words: the line search results quote (info.description) %>
                                    <% if (info.description) { %><p class="item-lead"><%= info.description %></p><% } %>
                                    <div class="item-desc">
                                        <%# the item's data is written here by the server (routes/router.js item_page, info.shown); its
                                            quality, type and classes open the item list with that filter %>
                                        <div class="desc">
                                            <div class="name"><%= __('filters.quality') %></div>
                                            <div class="val quality q-<%= info.item?.qualityID %>" translate="no"><% if (info.shown.links?.quality) { %><a href="<%= info.shown.links.quality %>"><%= info.shown.quality %></a><% } else { %><%= info.shown.quality || info.item?.qualityID %><% } %></div>
                                        </div>
                                        <div class="desc">
                                            <div class="name"><%= __('filters.type') %></div>
                                            <div class="val type"><% if (info.shown.links?.type) { %><a href="<%= info.shown.links.type %>"><%= info.shown.type %></a><% } else { %><%= info.shown.type %><% } %></div>
                                        </div>
                                        <% if (info.shown.classes.length > 0) { %>
                                        <div class="desc classes">
                                            <div class="name"><%= __('item.classes') %></div>
                                            <div class="val class"><% for (const { name, url } of (info.shown.links?.classes || info.shown.classes.map((name) => ({ name })))) { %><% if (url) { %><a class="class-el" href="<%= url %>"><%= name %></a><% } else { %><span class="class-el"><%= name %></span><% } %><% } %></div>
                                        </div>
                                        <% } %>
                                        <% if (info.collection) { %>
                                        <%# the item's TF2 collection; the list of its items is further down %>
                                        <div class="desc collection">
                                            <div class="name"><%= __('item.collection') %></div>
                                            <div class="val" translate="no"><% if (info.collection.items.length > 0) { %><a href="#collection"><%= info.collection.name %></a><% } else { %><%= info.collection.name %><% } %></div>
                                        </div>
                                        <% } %>
            <!--                             <% if (info.item?.effectID) { %>
                                            <div class="desc effect">
                                                <div class="name">EffectID</div>
                                                <div class="val"><%= info.item?.effectID %></div>
                                            </div>
                                        <% } %> -->
                                    </div>
                                    <%# outside sites, apart from the item's data so they don't read as one of its properties (proximity) %>
                                    <% const show_bptf = info.item?.bptf_data?.price > 0 || info.item?.type === "tool kit" || info.item?.type == "warpaint" || String(info.item?.type || '').includes('skin') %>
                                    <% if (show_bptf) { %>
                                    <div class="item-links" role="group" aria-label="<%= __('item.links') %>">
                                        <%# backpack.tf price page of this version of the item (service/bptf_link.js) %>
                                        <a class="item-link bptf" rel="nofollow noopener" target="_blank" href="<%= info.bptf_url %>">backpack.tf <span aria-hidden="true">↗</span></a>
                                    <% if (info.item?.bptf_data?.price > 0) { %>
                                        <a class="item-link tf2wiki" rel="noopener" target="_blank" href="https://wiki.teamfortress.com/wiki/<%= encodeURIComponent(info.item?.name || '') %>">TF2 Wiki <span aria-hidden="true">↗</span></a>
                                    <% } %>
                                    </div>
                                    <% } %>
                                    <div class="item-btns">
                                        <% const ks_list = Array.isArray(info.item?.killstreak) ? info.item.killstreak : (info.item?.killstreak?.killstreaks || []) %>
                                        <% if(ks_list.length > 0){ %>
                                            <%# options (tier names) are filled in by public/js/main.js from the item's killstreak prices %>
                                            <label class="killstreak__select" for="ks-select">
                                                <span><%= __('item.killstreak_tier') %></span>
                                                <select id="ks-select">
                                                    <option value="0"><%= __('filters.none') %></option>
                                                </select>
                                            </label>
                                        <% } else if((info.variants || []).some((v) => v.kind == 'paint')){ %>
                                            <%# a cosmetic's paints with their own price; options filled in by public/js/main.js (show_paint) %>
                                            <label class="killstreak__select paint__select" for="paint-select">
                                                <span><%= __('item.paint') %></span>
                                                <select id="paint-select">
                                                    <option value=""><%= __('filters.none') %></option>
                                                </select>
                                            </label>
                                        <% } %>
                                        <%# Buy first: it is what most visitors came for (serial position) %>
                                        <div class="item__trade buy">
                                            <button class="item__btn <% if(info.item?.stock?.cur > 0){ %> active <% } %>" id="buy"><span class="icon icon-credit"></span> <%= __('item.buy') %></button>
                                            <span class="price" id="buy-price"><%= info.shown.buy_price %></span>
                                            <span class="stock <%= info.shown.stock > 0 ? 'yes' : 'no' %>"><%- __('item.in_stock_html', { count: '<span>' + info.shown.stock + '</span>' }) %></span>
                                        </div>
                                        <% if(info.item?.status == 1){ %>
                                            <div class="item__trade sell">
                                                <button class="item__btn <% if(info.item?.stock?.cur < info.item?.stock?.limit){ %> active <% } %>" id="sell"><span class="icon icon-credit"></span> <%= __('item.sell') %></button>
                                                <span class="price" id="sell-price"><%= info.shown.sell_price %></span>
                                                <span class="stock <%= info.shown.can_sell > 0 ? 'yes' : 'no' %>"><%- __('item.can_buy_html', { count: '<span>' + info.shown.can_sell + '</span>' }) %></span>
                                            </div>
                                        <% } %>
                                        <% if (info.item?.stock?.limit === 0) { %>
                                            <div class="stock-limit"><%= __('item.cant_trade_now') %></div>
                                        <% } %>
                                    </div>
                                    <!-- 
                                        Unique, Strange, Vintage, Genuine weapons can't buy ks weapons for Non-KS price 
                                        if given ks is overstocked & there is stock space for Non-KS version
                                        ! This doesn't apply for skins and australiums !
                                    -->
                                </div>
                            </div>

                            <h2 class="item-header sales" style="margin-top: 2rem">
                                <%= __('js.item.sales_title') %>
                            </h2>
                            <div class="item_content sales" id="item-sales">
                                <div class="sales-top">
                                    <p class="sales-hint"><%= __('js.item.sales_hint') %></p>
                                    <div class="sales-range" role="group" aria-label="<%= __('js.item.sales_title') %>">
                                        <button type="button" data-range="30" aria-pressed="false"><%= __('js.item.range_30') %></button>
                                        <button type="button" data-range="90" aria-pressed="true"><%= __('js.item.range_90') %></button>
                                        <button type="button" data-range="365" aria-pressed="false"><%= __('js.item.range_365') %></button>
                                    </div>
                                </div>
                                <div class="sales-chart">
                                    <div class="sales-plot"></div>
                                    <div class="sales-tip" hidden></div>
                                </div>
                                <p class="sales-total"></p>
                            </div>

                            <h2 class="item-header history" style="margin-top: 2rem">
                                <%= __('item.price_history') %>
                            </h2>
                            <div class="item_content">
                                <div class="change_table">
                                    <div class="row main">
                                        <div class="cell buy"><%= __('item.buy') %></div>
                                        <div class="cell sell"><%= __('item.sell') %></div>
                                        <div class="cell time"><%= __('item.date') %></div>
                                    </div>
                                    <%# newest first; three rows, the older ones behind "show older prices". Buy and Sell as at the top
                                        of the page: Buy = what the visitor pays (the bots' sell price), Sell = what they get %>
                                    <div class="row more<%= info.shown.price_history.length > 3 ? ' visible' : '' %>"><%= __('item.older_prices') %></div>
                                    <% if (info.shown.price_history.length == 0) { %>
                                    <div class="row empty"><%= __('item.no_price_history') %></div>
                                    <% } %>
                                    <% info.shown.price_history.forEach((row, i) => { %>
                                    <div class="row<%= i >= 3 ? ' hidden' : '' %>"><div class="cell buy"><%= row.sell %></div><div class="cell sell"><%= row.buy %></div><div class="cell time"><time datetime="<%= row.day %>"><%= new Date(row.time).toLocaleDateString(html_lang) %></time></div></div>
                                    <% }) %>
                                </div>
                            </div>

                            <% if (info.faq?.length) { %>
                            <%# questions people search about the item, answered from its own prices, stock and sales (fn.item_faq) %>
                            <section class="item-faq" aria-labelledby="item-faq-title">
                                <h2 class="item-header faq" id="item-faq-title" style="margin-top: 2rem"><%= __('item.faq_title', { name: info.page_name || info.item?.bp_sku }) %></h2>
                                <div class="item_content faq">
                                    <% info.faq.forEach(({ q, a }) => { %>
                                    <h3 class="faq-q"><%= q %></h3>
                                    <p class="faq-a"><%= a %></p>
                                    <% }) %>
                                </div>
                            </section>
                            <% } %>

                            <% if (info.collection && info.collection.items.length > 0) { %>
                            <%# the item's TF2 collection (item_manager's item_collection): each item once, in its plainest
                                version, highest grade first; this item shown as this page shows it %>
                            <h2 class="item-header collection" id="collection" style="margin-top: 2rem">
                                <span translate="no"><%= info.collection.name %></span>
                                <span class="collection-count"><%= __('item.collection_count', { count: info.collection.items.length }) %></span>
                            </h2>
                            <div class="item_content collection">
                                <ul class="collection-list">
                                <% info.collection.items.forEach((row) => { %>
                                    <% const effect_bg = Number(row.effectID) > 0 ? `background-image: url(https://api.backpack.tf/images/440/particles/${Number(row.effectID)}_94x94.png);` : '' %>
                                    <%# the item's name, and which version of it the row opens ("Factory New", "Strange") %>
                                    <% const sku = String(row.bp_sku), base = String(row.name || '') %>
                                    <% const version = base && sku.includes(base) && sku != base ? sku.replace(base, ' ').replace(/[()]/g, ' ').replace(/\s+/g, ' ').trim() : '' %>
                                    <% const title = version || sku == base ? base : sku %>
                                    <li class="collection-row<%= row.current ? ' current' : '' %><%= row.grade ? ' g-' + row.grade : '' %>">
                                        <% if (row.current) { %><div class="collection-item" aria-current="page"><% } else { %><a class="collection-item" href="<%= lurl('/items/' + encodeURIComponent(row.bp_sku)) %>"><% } %>
                                            <img src="<%= row.image %>" alt="<%= item_alt(row) %>" loading="lazy" class="collection-img"<% if (effect_bg) { %> style="<%= effect_bg %>"<% } %>>
                                            <span class="collection-text">
                                                <span class="collection-name" translate="no" title="<%= sku %>"><%= title %></span>
                                                <% if (row.grade || version || row.current || row.paint_of_item || row.stock > 0) { %>
                                                <span class="collection-meta">
                                                    <% if (row.grade) { %><span class="collection-grade" translate="no"><%= row.grade[0].toUpperCase() + row.grade.slice(1) %></span><% } %>
                                                    <% if (version) { %><span class="collection-version" translate="no"><%= version %></span><% } %>
                                                    <% if (row.current) { %><span class="collection-here"><%= __('item.this_item') %></span><% } else if (row.paint_of_item) { %><span class="collection-here"><%= __('item.this_war_paint') %></span><% } %>
                                                    <% if (row.stock > 0) { %><span class="collection-stock"><%= __('item.in_stock', { count: row.stock }) %></span><% } %>
                                                </span>
                                                <% } %>
                                            </span>
                                            <span class="collection-price"><%= row.price %></span>
                                        <% if (row.current) { %></div><% } else { %></a><% } %>
                                    </li>
                                <% }) %>
                                </ul>
                            </div>
                            <% } %>

                            <% if (info.result.sameName.length > 0) { %>
                            <h2 class="item-header similarName" style="margin-top: 2rem">
                                <%= __('item.similar_names') %>
                            </h2>
                            <div class="item_content sim similarName">
                                <div class="container">
                                    <div class="similar_items">
                                        <% info.result.sameName.forEach((item) => { %>
                                            <a href="<%= lurl('/items/' + encodeURIComponent(item.bp_sku)) %>" class="item_card q-<%= item.qualityID %>">
                                                <div class="item-name" translate="no"><%= item.bp_sku %></div>
                                                <img src="<%= item.image %>" alt="<%= item_alt(item) %>" loading="lazy" class="item-image" style="background-image: url(https://api.backpack.tf/images/440/particles/<%= item.effectID %>_94x94.png);">
                                                <div class="item-data">
                                                    <div class="stock"><%= __('item.in_stock', { count: item.stock?.cur || 0 }) %></div>
                                                    <div class="price"><%= item.price %></div>
                                                    <div class="quality q-<%= item.qualityID %>"></div>
                                                </div>
                                            </a>
                                        <% }) %>
                                    </div>                        
                                </div>
                            </div>
                            <% } %>

                            <% if (info.result.sameEffect.length > 0) { %>
                            <h2 class="item-header similarEffect" style="margin-top: 2rem">
                                <%= __('item.similar_effect') %>
                            </h2>
                            <div class="item_content sim similarEffect">
                                <div class="container">
                                    <div class="similar_items">
                                        <% info.result.sameEffect.forEach((item) => { %>
                                            <a href="<%= lurl('/items/' + encodeURIComponent(item.bp_sku)) %>" class="item_card q-<%= item.qualityID %>">
                                                <div class="item-name" translate="no"><%= item.bp_sku %></div>
                                                <img src="<%= item.image %>" alt="<%= item_alt(item) %>" loading="lazy" class="item-image" style="background-image: url(https://api.backpack.tf/images/440/particles/<%= item.effectID %>_94x94.png);">
                                                <div class="item-data">
                                                    <div class="stock"><%= __('item.in_stock', { count: item.stock?.cur || 0 }) %></div>
                                                    <div class="price"><%= item.price %></div>
                                                    <div class="quality q-<%= item.qualityID %>"></div>
                                                </div>
                                            </a>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                            <% } %>

                            <% if (info.result.sameTypeQuality.length > 0) { %>
                            <h2 class="item-header similarType" style="margin-top: 2rem">
                                <%= __('item.similar_type') %>
                            </h2>
                            <div class="item_content sim similarType">
                                <div class="container">
                                    <div class="similar_items">
                                        <% info.result.sameTypeQuality.forEach((item) => { %>
                                            <a href="<%= lurl('/items/' + encodeURIComponent(item.bp_sku)) %>" class="item_card q-<%= item.qualityID %>">
                                                <div class="item-name" translate="no"><%= item.bp_sku %></div>
                                                <img src="<%= item.image %>" alt="<%= item_alt(item) %>" loading="lazy" class="item-image" style="background-image: url(https://api.backpack.tf/images/440/particles/<%= item.effectID %>_94x94.png);">
                                                <div class="item-data">
                                                    <div class="stock"><%= __('item.in_stock', { count: item.stock?.cur || 0 }) %></div>
                                                    <div class="price"><%= item.price %></div>
                                                    <div class="quality q-<%= item.qualityID %>"></div>
                                                </div>
                                            </a>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                            <% } %>
                        </div>

                        <div class="trade_item-view">
                            <div class="item-body">
                                <div class="trade-inv-window">
                                    <div class="trade-nav">
                                        <%# the item being sold / bought and its price (filled in by public/js/main.js) %>
                                        <div class="trade-item">
                                            <img src="<%= info.item?.image %>" alt="<%= item_alt(info.item) %>" class="trade-item-img">
                                            <div class="trade-item-text">
                                                <div class="trade-item-name" id="trade-item-name" translate="no"><%= info.page_name || info.item?.bp_sku %></div>
                                                <div class="trade-item-price"><span id="trade-mode" class="trade-mode"></span> <span id="trade-item-price"></span></div>
                                            </div>
                                        </div>
                                        <div class="trade-info">
                                            <div class="filter-btn" id="reload-trade-inv" title="<%= __('item.reload_inventory') %>"><span class="icon icon-spinner1"></span></div>
                                            <button id="remove-iit" title="<%= __('item.remove_selected_title') %>"><%= __('item.remove_selected') %></button>
                                        </div>
                                        <div class="trade-stats">
                                            <div class="trade-count">
                                                <span id="trade-count">0</span> <span><%= __('item.items') %></span>
                                            </div>
                                            <div class="trade-total">
                                                <div class="key-section">
                                                    <div class="amount" id="trade-key-total">0</div>
                                                    <span class="icon icon-key"></span>
                                                </div>
                                                <div class="ref-section">
                                                    <div class="amount" id="trade-ref-total">0.00</div>
                                                    <span class="icon icon-refined_metal"></span>
                                                </div>
                                            </div>
                                            <button id="trade-btn">
                                                <i class="icon icon-close"></i>
                                                <i class="icon icon-checkmark"></i>
                                                <span><%= __('trade.trade_btn') %></span>
                                                <div class="create-trade-animation">
                                                    <div class="lds-ellipsis"><div></div><div></div><div></div><div></div></div>
                                                </div>
                                            </button>
                                        </div>
                                    </div>
                                    <%# why the trade can't be sent yet, e.g. an odd number of 0.055 ref copies (js/plugins/trade.js -> set_trade_note) %>
                                    <p class="trade-note" id="trade-note" role="status"></p>
                                    <%# filters for the copies in the grid (bot, paint, spells, ...), built by public/js/plugins/item_filters.js %>
                                    <div class="item-filters" id="item-filters" hidden></div>
                                    <div class="items">
                                        <div class="loading-items" id="trade-loading">
                                            <span class="loader"></span>
                                            <span class="loader-text"><%= __('trade.loading_inventory') %></span>
                                            <span class="loader-text-small"><%= __('trade.loading_hint') %></span>
                                        </div>
                                        <div class="item-grid" id="trade-item-grid">
                                            <!-- load items here -->
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </main>
        </div>
        <script type="application/javascript">
            function round_ref (refs, direction) {
                // less than a scrap (half-scrap weapons, 0.055 ref) is shown as it is instead of rounding to 0
                if (direction === undefined && refs > 0 && refs < 0.11) return Number(refs.toFixed(3));
                let ref = Math.trunc(refs);
                let ref_float = refs - ref;
                ref_float = parseFloat(ref_float.toFixed(5));

                const steps = [0, 0.11, 0.22, 0.33, 0.44, 0.55, 0.66, 0.77, 0.88, 1];
                let float;

                if (direction === "up") {
                    float = steps.find(s => s >= ref_float) ?? 1;
                } else if (direction === "down") {
                    for (let i = steps.length - 1; i >= 0; i--) {
                        if (steps[i] <= ref_float) {
                            float = steps[i];
                            break;
                        }
                    }
                    if (float === undefined) float = 0;
                } else {
                    float = steps.reduce((a, b) =>
                        Math.abs(b - ref_float) < Math.abs(a - ref_float) ? b : a
                    );
                }

                if (ref + ref_float === 0.05) {
                    return 0.05;
                }

                return parseFloat((ref + float).toFixed(2));
            }

            const updateNavigation = (navigation) => {
                const hash = location.hash;

                if(hash === "#sell_item"){
                    navigation.html(`
                    <a href="<%= lurl('/items') %>"><%= __('nav.items') %></a>
                    <span class="spoiler">/</span>
                    <span class="current-item"><a href="#"><%= info.page_name || info.item?.bp_sku %></a></span>
                    <span class="spoiler">/</span>
                    <span class="current-item"><%= __('item.sell') %></span>
                    `)
                } else if (hash === "#buy_item"){
                    navigation.html(`
                    <a href="<%= lurl('/items') %>"><%= __('nav.items') %></a>
                    <span class="spoiler">/</span>
                    <span class="current-item"><a href="#"><%= info.page_name || info.item?.bp_sku %></a></span>
                    <span class="spoiler">/</span>
                    <span class="current-item"><%= __('item.buy') %></span>
                    `)
                } else {
                    navigation.html(`
                    <a href="<%= lurl('/items') %>"><%= __('nav.items') %></a>
                    <span class="spoiler">/</span>
                    <span class="current-item"><a href="#" class="current-item"><%= info.item?.bp_sku %></a></span>
                    `)
                }
            }

            // quality, type, classes, prices, stock, price history and similar items come from the server
            if($('img.image').attr('effect-id') != "0"){
                $('img.image').attr('style', `background-image: url(https://api.backpack.tf/images/440/particles/${$('img.image').attr('effect-id')}_188x188.png);`)
            }

            // "show older prices": three more rows per click
            $('.change_table .row.more').on('click', function(){
                $('.change_table .row.hidden').slice(0, 3).removeClass('hidden');
                if($('.change_table .row.hidden').length == 0){
                    $('.change_table .row.more').removeClass('visible')
                }
            })
        </script>
        <%- include('./partials/footer.ejs') %>
    </body>
</html>