<!DOCTYPE html>
<html lang="<%= html_lang %>">
    <%- include('./partials/head.ejs') %>
    <body class="<%= season_class %> <%= locals.look_class || "" %>">
        <%- include('./partials/nav.ejs') %>

        <main>
            <%# Key banking (service/key_bank.js, public/js/plugins/keys.js, styles scss/partials/views/_keys.scss).
                Nikolas 2026-11-28: "make site page design simpler like devide screen in to 2 for buy and sell". So the
                page is one desk split in two halves, Buy keys | Sell keys, each a whole swap on its own: the price,
                1 to 5 keys as key pictures, the bank bot (the one that can do the most is picked), the total and the
                button. The server draws it once; keys.js keeps it live and sends the request. %>
            <% const kb = info?.keybank || null %>
            <% const kb_on = !!(kb && kb.enabled && kb.price) %>
            <% const fmt = (n) => (Math.floor(Number(n) * 100 + 1e-6) / 100).toFixed(2) %>
            <% const max_keys = kb?.max_keys || 5 %>
            <% const key_pic = 'https://community.cloudflare.steamstatic.com/economy/image/fWFc82js0fmoRAP-qOIPu5THSWqfSmTELLqcUywGkijVjZULUrsm1j-9xgEAaR4uURrwvz0N252yVaDVWrRTno9m4ccG2GNqxlQoZrC2aG9hcVGUWflbX_drrVu5UGki5sAij6tOtQ/96fx96f' %>
            <% const ref_pic = 'https://community.cloudflare.steamstatic.com/economy/image/fWFc82js0fmoRAP-qOIPu5THSWqfSmTELLqcUywGkijVjZULUrsm1j-9xgEbZQsUYhTkhzJWhsO1Mv6NGucF1Ygzt8ZQijJukFMiMrbhYDEwI1yRVKNfD6xorQ3qW3Jr6546DNPuou9IOVK4p4kWJaA/96fx96f' %>
            <% const bots_list = kb?.bots || [] %>
            <%# the halves: the visitor's side ('buy' = they buy our keys at our sell price), which of our prices it uses %>
            <% const halves = [
                { side: 'buy', id: 'Buy', price: 'sell', title: __('keys.buy_keys'), hint: __('keys.we_sell_hint'), give: ref_pic, get: key_pic, total: __('keys.you_pay') },
                { side: 'sell', id: 'Sell', price: 'buy', title: __('keys.sell_keys'), hint: __('keys.we_buy_hint'), give: key_pic, get: ref_pic, total: __('keys.you_get') }
            ] %>
            <div class="page-section keys-ps" data-kb-root>
                <script type="application/json" id="keybank-data"><%- JSON.stringify(kb).replace(/</g, '\\u003c') %></script>

                <header class="kb-head">
                    <div class="kb-head-text">
                        <p class="kb-kicker"><%= __('keys.kicker') %></p>
                        <h1><%= __('keys.h1') %></h1>
                        <p class="kb-lede"><%= __('keys.lede', { max: max_keys }) %></p>
                    </div>
                    <p class="kb-live" data-kb-live data-state="<%= kb_on ? (kb.stale ? 'stale' : 'live') : 'off' %>"><i aria-hidden="true"></i><span data-kb-updated><%= kb_on ? (kb.stale ? __('keys.stale') : __('keys.live')) : __('keys.off') %></span></p>
                </header>

                <div class="kb-notice" data-kb-notice role="status" <%= kb_on ? 'hidden' : '' %>><%= kb ? __('keys.paused') : __('keys.unavailable') %></div>

                <div class="kb-desk">
                    <% halves.forEach((h) => { %>
                    <section class="kb-half is-<%= h.side %>" data-kb-half="<%= h.side %>" aria-labelledby="kb<%= h.id %>Title">
                        <div class="kb-half-head">
                            <h2 id="kb<%= h.id %>Title"><%= h.title %></h2>
                            <%# what you give → what you get, as the items themselves %>
                            <span class="kb-dir" aria-hidden="true"><img src="<%= h.give %>" alt="" width="96" height="96" data-no-fade><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 8h11M9.5 4l4 4-4 4"/></svg><img src="<%= h.get %>" alt="" width="96" height="96" data-no-fade></span>
                        </div>

                        <p class="kb-price"><b data-kb-price="<%= h.price %>"><%= kb_on ? fmt(kb.price[h.price]) : '—' %></b> <small>ref</small></p>
                        <p class="kb-price-hint"><%= h.hint %></p>

                        <div class="kb-amount">
                            <span class="kb-label" id="kb<%= h.id %>Amount"><%= __('keys.how_many') %></span>
                            <div class="kb-pips" role="group" aria-labelledby="kb<%= h.id %>Amount">
                                <% for (let i = 1; i <= max_keys; i++) { %>
                                <button type="button" class="kb-pip<%= i == 1 ? ' is-on' : '' %>" data-kb-n="<%= i %>" aria-pressed="<%= i == 1 %>" aria-label="<%= __('keys.n_keys', { n: i }) %>">
                                    <img src="<%= key_pic %>" alt="" width="96" height="96" data-no-fade>
                                    <span><%= i %></span>
                                </button>
                                <% } %>
                            </div>
                        </div>

                        <div class="kb-bot-pick">
                            <label class="kb-label" for="kb<%= h.id %>Bot"><%= __('keys.bot_label') %></label>
                            <% if (bots_list.length) { %>
                            <select id="kb<%= h.id %>Bot" data-kb-bot>
                                <% bots_list.forEach((b) => { %>
                                <option value="<%= b.steamid %>" <%= b.online ? '' : 'disabled' %>><%= b.name || b.steamid %><%= b.online ? '' : ` (${__('keys.offline')})` %></option>
                                <% }) %>
                            </select>
                            <% } else { %>
                            <p class="kb-empty"><%= __('keys.no_bots') %></p>
                            <% } %>
                            <p class="kb-cap" data-kb-cap aria-live="polite"></p>
                        </div>

                        <div class="kb-close">
                            <div class="kb-total" aria-live="polite">
                                <span class="kb-label"><%= h.total %></span>
                                <span class="kb-total-value" data-kb-total><img src="<%= ref_pic %>" alt="" data-no-fade><b><%= kb_on ? fmt(kb.price[h.price]) : '—' %></b> ref</span>
                            </div>
                            <% if (user) { %>
                            <button type="button" class="kb-go" data-kb-go <%= kb_on ? '' : 'disabled' %>><%= h.title %></button>
                            <% } else { %>
                            <a class="kb-go is-login" rel="nofollow" href="/auth/steam"><span class="icon icon-steam_circle" aria-hidden="true"></span> <%= __('keys.sign_in') %></a>
                            <% } %>
                        </div>
                    </section>
                    <% }) %>
                </div>

                <div class="kb-fine">
                    <p><%= __('keys.fine', { minutes: 10 }) %></p>
                    <p><b><%= __('keys.how_3_title') %>.</b> <%= __('keys.how_3', { max: max_keys }) %></p>
                </div>
            </div>
        </main>

        <%- include('./partials/footer.ejs') %>
    </body>
</html>
