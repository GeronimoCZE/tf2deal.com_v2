<div class="modal_overlay" id="modal_overlay">
    <div class="searchbar" id="searchbar" role="dialog" aria-modal="true" aria-labelledby="searchbar-title">
        <h2 class="sr-only" id="searchbar-title"><%= __('search.title') %></h2>
        <form id="search_modal_form" class="search" role="search" toolname="search_items" tooldescription="Search the Team Fortress 2 items that tf2deal.com buys and sells, by name. Opens the item list with prices and stock.">
            <span class="icon icon-search" aria-hidden="true"></span>
            <input type="text" id="searchbarItems" name="name" toolparamdescription="Item name or part of it, for example Team Captain" placeholder="<%= __('search.placeholder') %>" autocomplete="off" spellcheck="false" aria-label="<%= __('search.title') %>" aria-controls="searchbar-results">
            <button type="button" class="closeModal search-close" title="<%= __('search.close') %>" aria-label="<%= __('search.close') %>">Esc</button>
        </form>
        <ul class="suggestions" id="searchbar-results" role="listbox">
            <li><%= __('search.results_here') %></li>
        </ul>
    </div>

    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="modal_header">
            <div class="modal_name" id="modal-title"></div>
            <button type="button" class="closeModal" title="<%= __('search.close') %>" aria-label="<%= __('search.close') %>">&times;</button>
        </div>
        <div class="modal_content"></div>
    </div>
</div>

<footer>
    <div class="foo-content">
        <%# links grouped by what people come for (similar things together): trading, community, help, legal %>
        <div class="foo-links">
            <div class="foo-links-column">
                <div class="foo-col-heading"><%= __('footer.trading') %></div>
                <a href="<%= lurl('/trade') %>" class="foo-col-link">
                    <span><%= __('nav.trade') %></span>
                </a>
                <a href="<%= lurl('/items') %>" class="foo-col-link">
                    <span><%= __('nav.items') %></span>
                </a>
                <a href="<%= lurl('/about') %>#bots-table" class="foo-col-link">
                    <span><%= __('footer.bots') %></span>
                </a>
            </div>
            <div class="foo-links-column">
                <div class="foo-col-heading"><%= __('nav.community') %></div>
                <a href="<%= lurl('/giveaway') %>" class="foo-col-link">
                    <span><%= __('nav.giveaway') %></span>
                </a>
                <a href="<%= lurl('/blog') %>" class="foo-col-link">
                    <span><%= __('nav.blog') %></span>
                </a>
                <a href="<%= lurl('/about') %>" class="foo-col-link">
                    <span><%= __('nav.about') %></span>
                </a>
            </div>
            <div class="foo-links-column">
                <div class="foo-col-heading"><%= __('footer.help') %></div>
                <a href="<%= lurl('/about') %>#how-to-trade" class="foo-col-link">
                    <span><%= __('footer.how_to_trade') %></span>
                </a>
                <a href="<%= lurl('/') %>#faq" class="foo-col-link">
                    <span><%= __('footer.faq') %></span>
                </a>
                <a href="<%= lurl('/support') %>" class="foo-col-link">
                    <span><%= __('footer.support') %></span>
                </a>
            </div>
            <div class="foo-links-column">
                <div class="foo-col-heading"><%= __('footer.legal') %></div>
                <a href="<%= lurl('/terms-of-service') %>" class="foo-col-link">
                    <span><%= __('footer.tos') %></span>
                </a>
                <a href="<%= lurl('/cookies') %>" class="foo-col-link">
                    <span><%= __('footer.cookie_policy') %></span>
                </a>
                <a href="#cookie-settings" class="foo-col-link" data-cookie-settings>
                    <span><%= __('footer.cookie_settings') %></span>
                </a>
            </div>
        </div>
        <div class="foo-credits">
            <a href="<%= lurl('/') %>" class="foo-logo">
                <img src="<%= locals.season_class == 'theme-white' ? '/img/logotype-dark-528.webp' : '/img/logotype-528.webp' %>" width="528" height="100" loading="lazy" alt="TF2Deal" class="logotype">
            </a>
            <span class="text-block copyright">© <span id="current_year"></span></span>
            <div class="social-media">
                <a rel="nofollow" href="https://steamcommunity.com/groups/tradetf2deal" target="_blank" aria-label="Steam">
                    <span class="icon icon-steam_circle" aria-hidden="true"></span>
                </a>
                <a rel="nofollow" href="https://discord.gg/br3WvWaW5y" target="_blank" aria-label="Discord">
                    <span class="icon icon-discord" aria-hidden="true"></span>
                </a>
            </div>
        </div>
        <%# every item category page, on every page: the way in to the item lists by quality, type and class for visitors,
            and links to the category pages from the whole site for search engines (service/categories.js). The names
            are TF2 words and stay English, like the category pages' own; the group labels are the item filters' own words.
            A band of its own colour under the site's links and logo, right above the credit bar, so it reads as a
            separate part of the footer. %>
        <% if (locals.item_categories) { %>
        <nav class="foo-browse" aria-labelledby="foo-browse-title">
            <div class="foo-browse-inner">
                <div class="foo-browse-heading" id="foo-browse-title"><%= __('footer.items_by_category') %></div>
                <% for (const g of ['quality', 'type', 'class']) { const list = item_categories.filter((c) => c.param == g); if (!list.length) continue %>
                <div class="foo-browse-label" id="foo-browse-<%= g %>"><%= __('filters.' + g) %></div>
                <ul class="foo-browse-list" aria-labelledby="foo-browse-<%= g %>">
                    <% for (const c of list) { %><li><a href="<%= lurl(c.path) %>"><%= c.name %></a></li><% } %>
                </ul>
                <% } %>
            </div>
        </nav>
        <% } %>
        <div class="copyrights">
            <span class="text-block"><span><%- __('footer.powered_by', { steam: '<a rel="nofollow" href="https://steampowered.com" target="_blank">Steam</a>' }) %></span> <span class="between">-</span> <span><%- __('footer.particles_from', { bptf: '<a rel="nofollow" href="https://backpack.tf" target="_blank">backpack.tf</a>' }) %></span></span>
            <span class="creator-credit"><%- __('footer.created_by', { author: '<a rel="nofollow" href="https://malikweb.eu/" target="_blank">Nikolas Malík</a>' }) %></span>
        </div>
    </div>

</footer>
<%# language and theme for wide screens (the cog in the menu bar, views/partials/nav.ejs; public/js/plugins/navbar.js
opens it). At the end of the page, so its headings don't come before the page's own h1. %>
<% const theme_opts = theme_choices.map((code) => [code, __('nav.theme_' + (code == 'off' ? 'night' : code))]) %>
<dialog class="site-settings" id="siteSettings" aria-labelledby="siteSettingsTitle">
    <div class="ss-head">
        <h2 id="siteSettingsTitle"><%= __('nav.lang_theme') %></h2>
        <button type="button" class="ss-close" data-ss-close aria-label="<%= __('common.close') %>">&times;</button>
    </div>
    <section class="ss-section" aria-labelledby="ssLangTitle">
        <h3 id="ssLangTitle"><%= __('nav.language') %></h3>
        <div class="ss-langs">
            <% for (const code of langs) { %>
            <a class="ss-lang<%= code == lang ? ' active' : '' %>" href="<%= locals.lang_urls?.[code] || '/' %>" data-lang="<%= code %>" hreflang="<%= lang_tags[code] %>" lang="<%= lang_tags[code] %>"<%- code == lang ? ' aria-current="true"' : '' %>>
                <img src="/img/flags/<%= code %>_96x96.png" width="28" height="28" loading="lazy" alt="<%= lang_names[code] %>" aria-hidden="true">
                <span><%= lang_names[code] %></span>
            </a>
            <% } %>
        </div>
    </section>
    <section class="ss-section" aria-labelledby="ssThemeTitle">
        <h3 id="ssThemeTitle"><%= __('nav.theme') %></h3>
        <div class="ss-themes">
            <% for (const [code, name] of theme_opts) { %>
            <a class="ss-theme<%= code == theme ? ' active' : '' %>" href="/theme/<%= code %>" rel="nofollow"<%- code == theme ? ' aria-current="true"' : '' %>>
                <span class="theme-swatch theme-<%= code %>" aria-hidden="true"></span>
                <span class="ss-name"><%= name %></span>
                <% if (code == 'auto') { %><small><%= __('nav.theme_auto_hint') %></small><% } %>
            </a>
            <% } %>
        </div>
    </section>
</dialog>
<%# outside the footer: the footer's z-index would keep the cookie window under the nav %>
<%- include('./cookie_banner.ejs') %>
