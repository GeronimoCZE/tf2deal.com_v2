<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        // texts for the page scripts: __('trade.max_items'), lurl('/items') -> /de/items (see src/i18n.js)
        window.TD_LANG = '<%= lang %>';
        window.TD_I18N = <%- locals.client_i18n || '{}' %>;
        window.TD_PATH = location.pathname.replace(/^\/(<%= langs.filter((l) => l != 'en').join('|') %>)(?=\/|$)/, '') || '/';
        window.__ = function (key, vars) {
            var text = key.split('.').reduce(function (o, k) { return o != null ? o[k] : undefined }, window.TD_I18N);
            if (typeof text != 'string') return key;
            return vars ? text.replace(/\{(\w+)\}/g, function (m, k) { return vars[k] != null ? vars[k] : m }) : text;
        };
        window.lurl = function (p) { return window.TD_LANG == 'en' ? p : '/' + window.TD_LANG + (p == '/' ? '' : p) };
    </script>
<%
    // text for a JS template literal (`...`): escapes the characters that could end it or open a <script> tag
    const tl = (v) => String(v ?? '').replace(/\\/g, '\\\\').replace(/`/g, '\\`').replace(/\$\{/g, '\\${').replace(/</g, '\\u003c')

    // SEO values for this page. A route can override them through `info`:
    //   description, path (the page path without language), canonical (full URL), alternates ([{hreflang, href}]), no_hreflang, noindex, image, og_type, json_ld
    const seo_site = locals.site_url || 'https://tf2deal.com'
    const seo_title = (title == 'Home') ? __('title.home') : title
    const seo_description = info?.description || __('desc.default')
    const seo_path = info?.path || locals.page_path || '/'
    const seo_url = info?.canonical || (info?.path ? seo_site + lurl(info.path) : locals.canonical) || seo_site + '/'
    const seo_image = info?.image || seo_site + '/img/og-image.png'
    const seo_index = !(locals.noindex || info?.noindex)
%>
    <meta name="description" content="<%= seo_description %>">
    <meta name="keywords" content="TF2 Trade Site, TF2 Item Trading, Team Fortress 2 Bots">
    <meta name="author" content="Nikolas Malik"> 
   <link rel="icon" href="/img/icon96x96.png">
    <title><%= seo_title %></title>
    <link rel="canonical" href="<%= seo_url %>">
<% if (!seo_index) { %>
    <meta name="robots" content="noindex">
<% } else if (!info?.no_hreflang) { for (const alt of (info?.alternates || alternates(seo_site, seo_path))) { %>
    <link rel="alternate" hreflang="<%= alt.hreflang %>" href="<%= alt.href %>">
<% } } %>
    <meta property="og:type" content="<%= info?.og_type || 'website' %>">
    <meta property="og:site_name" content="TF2Deal.com">
    <meta property="og:locale" content="<%= locals.og_locale || 'en_US' %>">
    <meta property="og:title" content="<%= seo_title %>">
    <meta property="og:description" content="<%= seo_description %>">
    <meta property="og:url" content="<%= seo_url %>">
    <meta property="og:image" content="<%= seo_image %>">
    <meta name="twitter:card" content="<%= info?.image ? 'summary' : 'summary_large_image' %>">
    <meta name="theme-color" content="#3f2a77">
    <meta name="trustpilot-one-time-domain-verification-id" content="52e55ef4-45c6-4737-9d51-05ac93a6f222"/>
    <meta name="msvalidate.01" content="9195A6F398D088FC940A29A7FBEC7B6C" />

    <%# toast styles are only needed once a toast shows, so they load without holding up the page %>
    <link rel="stylesheet" href="<%= asset('/iziToast-master/dist/css/iziToast.min.css') %>" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="<%= asset('/iziToast-master/dist/css/iziToast.min.css') %>"></noscript>
    <style>
        .iziToast{
            min-height: unset !important;
        }
    </style>

<%
    // Who runs the site and what it is, on every page (schema.org). Pages add their own data with info.json_ld and can
    // point to these two by @id: { "@id": "<site>/#organization" }. Only facts the site itself states.
    const seo_org = {
        '@type': 'Organization',
        '@id': seo_site + '/#organization',
        name: 'TF2Deal.com',
        url: seo_site + '/',
        logo: seo_site + '/img/logo_icon.png',
        description: __('home.intro_1'),
        founder: { '@type': 'Person', name: 'Nikolas Malík' },
        sameAs: ['https://steamcommunity.com/groups/tradetf2deal', 'https://discord.gg/br3WvWaW5y'] // the footer links
    }
    const seo_website = {
        '@type': 'WebSite',
        '@id': seo_site + '/#website',
        name: 'TF2Deal.com',
        url: seo_site + '/',
        publisher: { '@id': seo_org['@id'] },
        // the item search: /items?name=... lists the matching items
        potentialAction: {
            '@type': 'SearchAction',
            target: { '@type': 'EntryPoint', urlTemplate: seo_site + '/items?name={search_term_string}' },
            'query-input': 'required name=search_term_string'
        }
    }
%>
    <script type="application/ld+json"><%- JSON.stringify({ '@context': 'https://schema.org', '@graph': [seo_org, seo_website] }).replace(/</g, '\\u003c') %></script>
<% if (info?.json_ld) { %>
