<div class="item-tooltip" id="item_tooltip">
    <div class="item_name" translate="no"></div>
    <div class="item_description" style="overflow: hidden; position: relative;">
        <div class="item-desc">
            <div class="desc_price">
                <div class="nan"><%= __('tooltip.not_buying') %></div>
                <div class="key_price" translate="no"><span id="key_amount"></span><span class="unit">keys</span></div>
                <div class="ref_price" translate="no"><span id="ref_amount"></span><span class="unit">ref</span></div>
            </div>
            <div class="desc_effect"></div>
            <div class="desc_festivized"></div>
            <div class="descs_">
                <div class="desc_cname">
                    <div class="value"></div>
                </div>
                <div class="desc_type">
                    <div class="title"><%= __('tooltip.type') %></div>
                    <div class="value"></div>
                </div>
                <div class="desc_class">
                    <div class="title"><%= __('tooltip.class') %></div>
                    <div class="value"></div>
                </div>
                <div class="desc_paint">
                    <div class="title"><%= __('tooltip.paint') %></div>
                    <div class="value"></div>
                </div>
                <div class="desc_killstreaker">
                    <div class="title"><%= __('tooltip.killstreaker') %></div>
                    <div class="value"></div>
                </div>
                <div class="desc_sheen">
                    <div class="title"><%= __('tooltip.sheen') %></div>
                    <div class="value"></div>
                </div>
                <div class="desc_spell">
                    <div class="title"><%= __('tooltip.spells') %></div>
                    <div class="value"></div>
                </div>
                <div class="desc_parts">
                    <div class="title"><%= __('tooltip.strange_parts') %></div>
                    <div class="value"></div>
                </div>
            </div>
        </div>
        <div class="pure-desc" style="text-align: left;">
            <%= __('tooltip.stock_is') %> <span id="pure_stock"></span>
            <span class="desc-automatic" style="display: block; margin-top: .2rem;"><%= __('tooltip.pure_auto') %></span>
        </div>
    </div>
    <img src="/img/logo_icon.png" alt="" style="position: absolute; top: 2.5rem; left: -.7rem; opacity: .015; width: 8rem; filter: grayscale(100%);">
</div>