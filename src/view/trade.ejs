                                        <div class="fd-value" data-value="War Paint"><span class="icon icon-autoselect"></span> <%= __('item_types.war_paint') %></div>
                                        <div class="fd-value" data-value="Tool"><span class="icon icon-wrench"></span> <%= __('item_types.tool') %></div>
