        <script>
            
            const user_particle_dropdown = $('.user-window .filter[filter="particle"] .filter-dropdown')
            const site_particle_dropdown = $('.site-window .filter[filter="particle"] .filter-dropdown')
            const checkEffectFilter = setInterval(() => {
                if(site_particle_dropdown.children('.fd-value').length != 1){ clearInterval(checkEffectFilter) }
                fillParticleFilter(JSON.parse(localStorage.getItem('unusual_effects')))
            }
            , 2000
            );

            async function fillParticleFilter(eff_arr){
                if(eff_arr != undefined && site_particle_dropdown.children('.fd-value').length == 1){
                    eff_arr.forEach(effect => {
                        site_particle_dropdown.append(`<div class="fd-value" data-value="${effect.name}" style="overflow-wrap: break-word;">${effect.name}</div>`)
                        user_particle_dropdown.append(`<div class="fd-value" data-value="${effect.name}" style="overflow-wrap: break-word;">${effect.name}</div>`)
                    });
                }
            }

            document.querySelectorAll('.filter-btn').forEach((btn) => {
                if(btn.id === "reload-user-inv" || btn.id === "reload-site-inv"){ return; }
                btn.addEventListener('click', () => {
                    btn.parentElement.querySelector('.filter-box').classList.toggle('hidden')
                    btn.classList.toggle('active')
                })
            })
        </script>
        
