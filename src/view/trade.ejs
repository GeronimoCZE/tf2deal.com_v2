                                        <span><%= __('filters.class') %></span>
                                    </div>
                                    <div class="filter-value"></div>
                                    <div class="filter-dropdown">
                                        <div class="fd-value none" data-value="None"><span class="icon icon-close"></span> <%= __('filters.none') %></div>
                                        <div class="fd-value" data-value="All Classes"><%= __('classes.all') %></div>
                                        <div class="fd-value" data-value="Scout"><%= __('classes.scout') %></div>
                                        <div class="fd-value" data-value="Soldier"><%= __('classes.soldier') %></div>
                                        <div class="fd-value" data-value="Pyro"><%= __('classes.pyro') %></div>
                                        <div class="fd-value" data-value="Demoman"><%= __('classes.demoman') %></div>
                                        <div class="fd-value" data-value="Heavy"><%= __('classes.heavy') %></div>
                                        <div class="fd-value" data-value="Engineer"><%= __('classes.engineer') %></div>
                                        <div class="fd-value" data-value="Medic"><%= __('classes.medic') %></div>
                                        <div class="fd-value" data-value="Sniper"><%= __('classes.sniper') %></div>
                                        <div class="fd-value" data-value="Spy"><%= __('classes.spy') %></div>
                                    </div>
                                </div>
                                <div class="filter" filter="item-order" value="none">
                                    <div class="filter-name">
                                        <span><%= __('filters.order') %></span>
                                    </div>
                                    <div class="filter-value"></div>
                                    <div class="filter-dropdown">
                                        <div class="fd-value none" data-value="None"><span class="icon icon-close"></span> <%= __('filters.none') %></div>
                                        <div class="fd-value" data-value="Descending"><span class="icon icon-desc"></span> <%= __('filters.descending') %></div>
                                        <div class="fd-value" data-value="Ascending"><span class="icon icon-asc"></span> <%= __('filters.ascending') %></div>
                                    </div>
                                </div>
                                <div class="filter" filter="price" value="none">
                                    <div class="filter-name">
                                        <span><%= __('filters.price') %></span>
                                    </div>
                                    <div class="filter-value"></div>
                                    <div class="filter-dropdown">
                                        <div class="fd-value none" data-value="None"><span class="icon icon-close"></span> <%= __('filters.none') %></div>
                                        <div class="fd-value" data-value="0 - 1">0 - 1 <span class="icon icon-key"></span></div>
                                        <div class="fd-value" data-value="1 - 5">1 - 5 <span class="icon icon-key"></span></div>
                                        <div class="fd-value" data-value="5 - 15">5 - 15 <span class="icon icon-key"></span></div>
                                        <div class="fd-value" data-value="15 - 50">15 - 50 <span class="icon icon-key"></span></div>
                                        <div class="fd-value" data-value="50+">50+ <span class="icon icon-key"></span></div>
                                    </div>
                                </div>
                                <div class="reset-filters user"><%= __('filters.reset_all') %></div>

                            </div>
                            <div class="filter-btn" id="reload-user-inv"><span class="icon icon-spinner1"></span></div>
                            <form action="" method="post" class="input-filter" id="user-input-filter">
                                <input type="text" name="" id="" spellcheck="false" placeholder="<%= __('items.search_placeholder') %>">
                                <button type="submit"><span class="icon icon-search"></span></button>
                            </form>
                        </div>
                        <div class="items" items-loaded="false">
                            <% if(user){ %>
                                <!-- once items loaded -> save in localstorage -> refresh on button click (rate limit / minute) -->
                                <div class="loading-items" id="user-loading">
                                    <span class="loader"></span>
                                    <span class="loader-text"><%= __('trade.loading_inventory') %></span>
                                    <span class="loader-text-small"><%= __('trade.loading_hint') %></span>
                                </div>
                                <div class="item-grid" id="user-item-grid">
                                    <!-- load items here -->
                                </div>
                                <script type="application/javascript">
                                    /* make inv fetch client sided! => send data to server => process => render */
                                    /* deploy cors-anywhere server */
        
                                    let user_inv_anim = document.querySelector('body > main > div > div.trade-inv-window.user-window > div.items > div.loading-items.user-el');
        
                                    $('#reload-btn').click(function(){
                                        $(this).toggleClass('animate')
                                        user_inv_anim.classList.toggle('hidden')
                                        setTimeout(function(){
                                            $('#reload-btn').toggleClass('animate')
                                            user_inv_anim.classList.toggle('hidden')
                                        }, 5000)
                                    })
                                </script>
                            <% } else { %>
                                <%- include('./partials/login_btn.ejs') %>
                                <style>
                                    .user-window .items{
                                        align-items: center !important;
                                        justify-content: center !important;
                                    }
                                </style>
                            <% } %>
                        </div>
